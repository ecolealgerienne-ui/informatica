    <!-- Expression — une seule règle : UPPER(LTRIM(RTRIM(NOM))) -->
    <TRANSFORMATION DESCRIPTION="Normalisation du nom : suppression espaces + majuscules"
                    NAME="EXP_NORMALISE" OBJECTVERSION="1"
                    REUSABLE="NO" TYPE="Expression" VERSIONNUMBER="1">
      <TRANSFORMFIELD DATATYPE="number" DEFAULTVALUE="" DESCRIPTION=""
