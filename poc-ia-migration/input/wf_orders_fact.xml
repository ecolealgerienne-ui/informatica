<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE POWERMART SYSTEM "powrmart.dtd">
<POWERMART CREATION_DATE="06/24/2026 08:00:00" REPOSITORY_VERSION="184.94">
<REPOSITORY NAME="REP_PROD" VERSION="184" CODEPAGE="UTF-8" DATABASETYPE="Oracle">
<FOLDER NAME="MIGRATION_POC" GROUP="" OWNER="etl_dev" SHARED="NOTSHARED" DESCRIPTION="POC Migration" PERMISSIONS="rwx---r--">

  <MAPPING NAME="m_orders_fact" ISVALID="YES" OBJECTVERSION="1" VERSIONNUMBER="1"
           DESCRIPTION="Charge la table de faits commandes avec jointure clients/produits et agregation mensuelle">

    <!-- ============================================================ -->
    <!-- SOURCE 1 : ORDERS (table principale)                          -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Source Qualifier" NAME="SQ_ORDERS" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO" DESCRIPTION="Extraction commandes du mois">
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="ORDER_ID"       PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="CLIENT_ID"      PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="PRODUCT_ID"     PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="ORDER_DATE"     PRECISION="29" SCALE="9" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="QUANTITY"       PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="UNIT_PRICE"     PRECISION="12" SCALE="2" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="DISCOUNT_PCT"   PRECISION="5"  SCALE="2" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CHANNEL_CODE"   PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="COUNTRY_CODE"   PRECISION="3"  SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="ORDER_STATUS"   PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TABLEATTRIBUTE NAME="Sql Query" VALUE="SELECT O.ORDER_ID, O.CLIENT_ID, O.PRODUCT_ID, O.ORDER_DATE, O.QUANTITY, O.UNIT_PRICE, O.DISCOUNT_PCT, O.CHANNEL_CODE, O.COUNTRY_CODE, O.ORDER_STATUS FROM ORDERS O WHERE O.ORDER_DATE &gt;= TO_DATE('$$BATCH_DATE', 'YYYY-MM-DD') AND O.ORDER_STATUS NOT IN ('CANCELLED', 'DRAFT')"/>
      <TABLEATTRIBUTE NAME="Source Table" VALUE="ORDERS"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- SOURCE 2 : ORDER_LINES (detail lignes)                        -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Source Qualifier" NAME="SQ_ORDER_LINES" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO" DESCRIPTION="Extraction lignes de commande">
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="LINE_ID"        PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="ORDER_ID"       PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="PRODUCT_ID"     PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="LINE_QTY"       PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="LINE_AMOUNT"    PRECISION="12" SCALE="2" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="PROMO_CODE"     PRECISION="20" SCALE="0" PORTTYPE="OUTPUT"/>
      <TABLEATTRIBUTE NAME="Sql Query" VALUE="SELECT LINE_ID, ORDER_ID, PRODUCT_ID, LINE_QTY, LINE_AMOUNT, NVL(PROMO_CODE, 'NONE') AS PROMO_CODE FROM ORDER_LINES WHERE ORDER_ID IN (SELECT ORDER_ID FROM ORDERS WHERE ORDER_DATE &gt;= TO_DATE('$$BATCH_DATE', 'YYYY-MM-DD'))"/>
      <TABLEATTRIBUTE NAME="Source Table" VALUE="ORDER_LINES"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- JOINER : ORDERS + ORDER_LINES                                 -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Joiner" NAME="JNR_ORDERS_LINES" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO" DESCRIPTION="Jointure commandes et lignes">
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="ORDER_ID"       PRECISION="10" SCALE="0" PORTTYPE="INPUT"  INPUTFROMTRANSFORMATION="SQ_ORDERS"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="CLIENT_ID"      PRECISION="10" SCALE="0" PORTTYPE="INPUT"  INPUTFROMTRANSFORMATION="SQ_ORDERS"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="ORDER_DATE"     PRECISION="29" SCALE="9" PORTTYPE="INPUT"  INPUTFROMTRANSFORMATION="SQ_ORDERS"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="QUANTITY"       PRECISION="10" SCALE="0" PORTTYPE="INPUT"  INPUTFROMTRANSFORMATION="SQ_ORDERS"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="UNIT_PRICE"     PRECISION="12" SCALE="2" PORTTYPE="INPUT"  INPUTFROMTRANSFORMATION="SQ_ORDERS"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="DISCOUNT_PCT"   PRECISION="5"  SCALE="2" PORTTYPE="INPUT"  INPUTFROMTRANSFORMATION="SQ_ORDERS"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CHANNEL_CODE"   PRECISION="10" SCALE="0" PORTTYPE="INPUT"  INPUTFROMTRANSFORMATION="SQ_ORDERS"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="COUNTRY_CODE"   PRECISION="3"  SCALE="0" PORTTYPE="INPUT"  INPUTFROMTRANSFORMATION="SQ_ORDERS"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="LINE_ID"        PRECISION="10" SCALE="0" PORTTYPE="INPUT"  INPUTFROMTRANSFORMATION="SQ_ORDER_LINES"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="D_ORDER_ID"     PRECISION="10" SCALE="0" PORTTYPE="INPUT"  INPUTFROMTRANSFORMATION="SQ_ORDER_LINES"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="LINE_QTY"       PRECISION="10" SCALE="0" PORTTYPE="INPUT"  INPUTFROMTRANSFORMATION="SQ_ORDER_LINES"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="LINE_AMOUNT"    PRECISION="12" SCALE="2" PORTTYPE="INPUT"  INPUTFROMTRANSFORMATION="SQ_ORDER_LINES"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="PROMO_CODE"     PRECISION="20" SCALE="0" PORTTYPE="INPUT"  INPUTFROMTRANSFORMATION="SQ_ORDER_LINES"/>
      <TABLEATTRIBUTE NAME="Join Type"      VALUE="Normal Join"/>
      <TABLEATTRIBUTE NAME="Join Condition" VALUE="ORDER_ID = D_ORDER_ID"/>
      <TABLEATTRIBUTE NAME="Master Source"  VALUE="SQ_ORDER_LINES"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- LOOKUP : DIMENSION CLIENTS (pour enrichissement)              -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Lookup Procedure" NAME="LKP_CLIENT_SEGMENT" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO" DESCRIPTION="Recupere segment client">
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="IN_CLIENT_ID"   PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="SEGMENT_CODE"   PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="PAYS_CODE"      PRECISION="3"  SCALE="0" PORTTYPE="OUTPUT"/>
      <TABLEATTRIBUTE NAME="Lookup table name" VALUE="DIM_CLIENTS"/>
      <TABLEATTRIBUTE NAME="Lookup Condition"  VALUE="IN_CLIENT_ID = CLIENT_ID"/>
      <TABLEATTRIBUTE NAME="Lookup Policy On Multiple Match" VALUE="Return First Row"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- EXPRESSION : CALCULS FINANCIERS ET DATES                      -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Expression" NAME="EXP_ORDER_CALC" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO" DESCRIPTION="Calculs montants commande et dates analytiques">
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="ORDER_ID"            PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="CLIENT_ID"           PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="ORDER_DATE"          PRECISION="29" SCALE="9" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="LINE_AMOUNT"         PRECISION="12" SCALE="2" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="UNIT_PRICE"          PRECISION="12" SCALE="2" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="LINE_QTY"            PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="DISCOUNT_PCT"        PRECISION="5"  SCALE="2" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CHANNEL_CODE"        PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="COUNTRY_CODE"        PRECISION="3"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="PROMO_CODE"          PRECISION="20" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="SEGMENT_CODE"        PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="PAYS_CODE"           PRECISION="3"  SCALE="0" PORTTYPE="INPUT"/>
      <!-- Outputs calculés -->
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="GROSS_AMOUNT"        PRECISION="14" SCALE="2" PORTTYPE="OUTPUT"
                      EXPRESSION="LINE_QTY * UNIT_PRICE"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="DISCOUNT_AMOUNT"     PRECISION="14" SCALE="2" PORTTYPE="OUTPUT"
                      EXPRESSION="GROSS_AMOUNT * DISCOUNT_PCT / 100"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="NET_AMOUNT"          PRECISION="14" SCALE="2" PORTTYPE="OUTPUT"
                      EXPRESSION="GROSS_AMOUNT - DISCOUNT_AMOUNT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="ORDER_YEAR"          PRECISION="4"  SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="TO_INTEGER(TO_CHAR(ORDER_DATE, 'YYYY'))"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="ORDER_MONTH"         PRECISION="2"  SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="TO_INTEGER(TO_CHAR(ORDER_DATE, 'MM'))"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="ORDER_WEEK"          PRECISION="2"  SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="TO_INTEGER(TO_CHAR(ORDER_DATE, 'WW'))"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CHANNEL_CLEAN"       PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="LTRIM(RTRIM(UPPER(CHANNEL_CODE)))"/>
      <TRANSFORMFIELD DATATYPE="integer"   NAME="HAS_PROMO"           PRECISION="1"  SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="IIF(PROMO_CODE != 'NONE' AND NOT ISNULL(PROMO_CODE), 1, 0)"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="BATCH_DATE_OUT"      PRECISION="29" SCALE="9" PORTTYPE="OUTPUT"
                      EXPRESSION="TO_DATE($$BATCH_DATE, 'YYYY-MM-DD')"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="DW_LOAD_DATE"        PRECISION="29" SCALE="9" PORTTYPE="OUTPUT"
                      EXPRESSION="SYSDATE"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- AGGREGATOR : CUMUL MENSUEL PAR CLIENT/PRODUIT/CANAL           -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Aggregator" NAME="AGG_MONTHLY_ORDERS" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO" DESCRIPTION="Agregation mensuelle commandes par client et canal">
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="CLIENT_ID"       PRECISION="10" SCALE="0" PORTTYPE="INPUT"  AGGREGATEBY="Group By"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="SEGMENT_CODE"    PRECISION="10" SCALE="0" PORTTYPE="INPUT"  AGGREGATEBY="Group By"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="PAYS_CODE"       PRECISION="3"  SCALE="0" PORTTYPE="INPUT"  AGGREGATEBY="Group By"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CHANNEL_CLEAN"   PRECISION="10" SCALE="0" PORTTYPE="INPUT"  AGGREGATEBY="Group By"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="COUNTRY_CODE"    PRECISION="3"  SCALE="0" PORTTYPE="INPUT"  AGGREGATEBY="Group By"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="ORDER_YEAR"      PRECISION="4"  SCALE="0" PORTTYPE="INPUT"  AGGREGATEBY="Group By"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="ORDER_MONTH"     PRECISION="2"  SCALE="0" PORTTYPE="INPUT"  AGGREGATEBY="Group By"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="ORDER_COUNT"     PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="COUNT(ORDER_ID)" AGGREGATEBY="Count"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="TOTAL_GROSS"     PRECISION="16" SCALE="2" PORTTYPE="OUTPUT"
                      EXPRESSION="SUM(GROSS_AMOUNT)" AGGREGATEBY="Sum"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="TOTAL_DISCOUNT"  PRECISION="16" SCALE="2" PORTTYPE="OUTPUT"
                      EXPRESSION="SUM(DISCOUNT_AMOUNT)" AGGREGATEBY="Sum"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="TOTAL_NET"       PRECISION="16" SCALE="2" PORTTYPE="OUTPUT"
                      EXPRESSION="SUM(NET_AMOUNT)" AGGREGATEBY="Sum"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="TOTAL_QTY"       PRECISION="12" SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="SUM(LINE_QTY)" AGGREGATEBY="Sum"/>
      <TRANSFORMFIELD DATATYPE="integer"   NAME="PROMO_ORDERS"    PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="SUM(HAS_PROMO)" AGGREGATEBY="Sum"/>
      <TABLEATTRIBUTE NAME="Sorted Input" VALUE="YES"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- TARGET : FACT_ORDERS_MONTHLY                                  -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Target Definition" NAME="TGT_FACT_ORDERS" ISVALID="YES"
