<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE POWERMART SYSTEM "powrmart.dtd">
<POWERMART CREATION_DATE="06/24/2026 08:00:00" REPOSITORY_VERSION="184.94">
<REPOSITORY NAME="REP_PROD" VERSION="184" CODEPAGE="UTF-8" DATABASETYPE="Oracle">
<FOLDER NAME="MIGRATION_POC" GROUP="" OWNER="etl_dev" SHARED="NOTSHARED" DESCRIPTION="POC Migration" PERMISSIONS="rwx---r--">

  <MAPPING NAME="m_unconnected_lkp" ISVALID="YES" OBJECTVERSION="1" VERSIONNUMBER="1"
           DESCRIPTION="Demonstration du lookup non connecte appele comme fonction dans une expression - MEDIUM/HIGH">

    <!--
      PATTERN CLE : Unconnected Lookup
      ===================================
      Contrairement au lookup connecte (flux de donnees direct), l'unconnected lookup
      est APPELE comme une fonction dans une expression via la syntaxe :
          :LKP.LKP_REF_PAYS(COUNTRY_CODE)
      Il retourne une valeur scalaire, sans port de connexion direct.

      Defi migration : le CodeGen naif va generer un apply() row-level.
      La bonne implementation est un pre-chargement en dict ou merge.
    -->

    <!-- ============================================================ -->
    <!-- SOURCE : TABLE EMPLOYES                                        -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Source Qualifier" NAME="SQ_EMPLOYES" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO" DESCRIPTION="Extraction employes actifs">
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="EMP_ID"          PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="NOM"             PRECISION="100" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="PRENOM"          PRECISION="100" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="DEPT_CODE"       PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="COUNTRY_CODE"    PRECISION="3"  SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="SITE_CODE"       PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="SALAIRE"         PRECISION="12" SCALE="2" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="GRADE"           PRECISION="5"  SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CONTRAT_TYPE"    PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="DATE_EMBAUCHE"   PRECISION="29" SCALE="9" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="STATUT_EMP"      PRECISION="5"  SCALE="0" PORTTYPE="OUTPUT"/>
      <TABLEATTRIBUTE NAME="Sql Query" VALUE="SELECT EMP_ID, NOM, PRENOM, DEPT_CODE, COUNTRY_CODE, SITE_CODE, SALAIRE, GRADE, CONTRAT_TYPE, DATE_EMBAUCHE, STATUT_EMP FROM EMPLOYES WHERE STATUT_EMP = 'ACTIF' AND DATE_EMBAUCHE &lt;= TO_DATE('$$BATCH_DATE', 'YYYY-MM-DD')"/>
      <TABLEATTRIBUTE NAME="Source Table" VALUE="EMPLOYES"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- UNCONNECTED LOOKUP 1 : REF_PAYS                               -->
    <!-- Appele via :LKP.LKP_REF_PAYS(COUNTRY_CODE) dans EXP          -->
    <!-- Retourne : PAYS_LABEL, ZONE_GEO, FISCAL_RATE                  -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Lookup Procedure" NAME="LKP_REF_PAYS" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="YES"
                    DESCRIPTION="UNCONNECTED - lookup pays appele comme fonction dans expression">
      <TRANSFORMFIELD DATATYPE="string"    NAME="IN_COUNTRY_CODE" PRECISION="3"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="PAYS_LABEL"      PRECISION="50" SCALE="0" PORTTYPE="RETURN"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="ZONE_GEO"        PRECISION="20" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="FISCAL_RATE"     PRECISION="5"  SCALE="4" PORTTYPE="OUTPUT"/>
      <TABLEATTRIBUTE NAME="Lookup table name"     VALUE="REF_PAYS"/>
      <TABLEATTRIBUTE NAME="Lookup Condition"      VALUE="IN_COUNTRY_CODE = COUNTRY_CODE"/>
      <TABLEATTRIBUTE NAME="Lookup Policy On Multiple Match" VALUE="Return First Row"/>
      <!-- UNCONNECTED : pas de port connecte directement au flux principal -->
      <TABLEATTRIBUTE NAME="Connection Information" VALUE="UNCONNECTED"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- UNCONNECTED LOOKUP 2 : REF_GRADE_COEFF                        -->
    <!-- Appele via :LKP.LKP_GRADE_COEFF(GRADE) dans EXP              -->
    <!-- Retourne : GRADE_LABEL, COEFF_ANCIENNETE, BONUS_RATE           -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Lookup Procedure" NAME="LKP_GRADE_COEFF" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="YES"
                    DESCRIPTION="UNCONNECTED - coefficients grade appeles comme fonction dans expression">
      <TRANSFORMFIELD DATATYPE="string"    NAME="IN_GRADE"        PRECISION="5"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="GRADE_LABEL"     PRECISION="30" SCALE="0" PORTTYPE="RETURN"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="COEFF_ANCIENNETE" PRECISION="5" SCALE="4" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="BONUS_RATE"      PRECISION="5"  SCALE="4" PORTTYPE="OUTPUT"/>
      <TABLEATTRIBUTE NAME="Lookup table name"     VALUE="REF_GRADE_COEFF"/>
      <TABLEATTRIBUTE NAME="Lookup Condition"      VALUE="IN_GRADE = GRADE"/>
      <TABLEATTRIBUTE NAME="Lookup Policy On Multiple Match" VALUE="Return First Row"/>
      <TABLEATTRIBUTE NAME="Connection Information" VALUE="UNCONNECTED"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- EXPRESSION : UTILISE LES DEUX LOOKUPS NON CONNECTES           -->
    <!-- Syntaxe Informatica : :LKP.LKP_REF_PAYS(COUNTRY_CODE)        -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Expression" NAME="EXP_EMP_ENRICH" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO"
                    DESCRIPTION="Enrichissement employe via lookups non connectes et calculs remuneration">
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="EMP_ID"          PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="NOM"             PRECISION="100" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="PRENOM"          PRECISION="100" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="DEPT_CODE"       PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="COUNTRY_CODE"    PRECISION="3"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="SITE_CODE"       PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="SALAIRE"         PRECISION="12" SCALE="2" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="GRADE"           PRECISION="5"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CONTRAT_TYPE"    PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="DATE_EMBAUCHE"   PRECISION="29" SCALE="9" PORTTYPE="INPUT"/>
      <!-- Outputs calculés — certains via appel :LKP -->
      <TRANSFORMFIELD DATATYPE="string"    NAME="NOM_CLEAN"       PRECISION="100" SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="LTRIM(RTRIM(UPPER(NOM)))"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="PRENOM_CLEAN"    PRECISION="100" SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="LTRIM(RTRIM(INITCAP(PRENOM)))"/>
      <!-- APPEL UNCONNECTED LOOKUP 1 : retourne PAYS_LABEL -->
      <TRANSFORMFIELD DATATYPE="string"    NAME="PAYS_LABEL"      PRECISION="50" SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION=":LKP.LKP_REF_PAYS(COUNTRY_CODE)"/>
      <!-- APPEL UNCONNECTED LOOKUP 1 : autre colonne ZONE_GEO -->
      <TRANSFORMFIELD DATATYPE="string"    NAME="ZONE_GEO"        PRECISION="20" SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION=":LKP.LKP_REF_PAYS(COUNTRY_CODE).ZONE_GEO"/>
      <!-- APPEL UNCONNECTED LOOKUP 1 : taux fiscal -->
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="FISCAL_RATE"     PRECISION="5"  SCALE="4" PORTTYPE="OUTPUT"
                      EXPRESSION="NVL(:LKP.LKP_REF_PAYS(COUNTRY_CODE).FISCAL_RATE, 0.20)"/>
      <!-- APPEL UNCONNECTED LOOKUP 2 : grade label -->
      <TRANSFORMFIELD DATATYPE="string"    NAME="GRADE_LABEL"     PRECISION="30" SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION=":LKP.LKP_GRADE_COEFF(GRADE)"/>
      <!-- APPEL UNCONNECTED LOOKUP 2 : coefficient anciennete -->
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="COEFF_ANCIENNETE" PRECISION="5" SCALE="4" PORTTYPE="OUTPUT"
                      EXPRESSION="NVL(:LKP.LKP_GRADE_COEFF(GRADE).COEFF_ANCIENNETE, 1.0)"/>
      <!-- Calculs dependants des lookups -->
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="ANCIENNETE_ANS"  PRECISION="5"  SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="DATEDIFF(TO_DATE('$$BATCH_DATE', 'YYYY-MM-DD'), DATE_EMBAUCHE, 'YY')"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="SALAIRE_BRUT_AJUSTE" PRECISION="14" SCALE="2" PORTTYPE="OUTPUT"
                      EXPRESSION="SALAIRE * NVL(:LKP.LKP_GRADE_COEFF(GRADE).COEFF_ANCIENNETE, 1.0)"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="RETENUE_FISCALE" PRECISION="12" SCALE="2" PORTTYPE="OUTPUT"
                      EXPRESSION="SALAIRE_BRUT_AJUSTE * NVL(:LKP.LKP_REF_PAYS(COUNTRY_CODE).FISCAL_RATE, 0.20)"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="SALAIRE_NET"     PRECISION="14" SCALE="2" PORTTYPE="OUTPUT"
                      EXPRESSION="SALAIRE_BRUT_AJUSTE - RETENUE_FISCALE"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CONTRAT_LABEL"   PRECISION="30" SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="DECODE(CONTRAT_TYPE, 'CDI', 'Contrat Duree Indeterminee', 'CDD', 'Contrat Duree Determinee', 'INT', 'Interimaire', 'STG', 'Stage', 'Autre')"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="DW_LOAD_DATE"    PRECISION="29" SCALE="9" PORTTYPE="OUTPUT"
                      EXPRESSION="SYSDATE"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="BATCH_DATE_OUT"  PRECISION="29" SCALE="9" PORTTYPE="OUTPUT"
                      EXPRESSION="TO_DATE($$BATCH_DATE, 'YYYY-MM-DD')"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- FILTER : EMPLOYES AVEC PAYS RECONNU                           -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Filter" NAME="FIL_PAYS_CONNU" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO"
                    DESCRIPTION="Garde uniquement les employes dont le pays est reference">
      <TRANSFORMFIELD DATATYPE="string"    NAME="PAYS_LABEL"      PRECISION="50" SCALE="0" PORTTYPE="INPUT"/>
      <TABLEATTRIBUTE NAME="Filter Condition" VALUE="NOT ISNULL(PAYS_LABEL) AND PAYS_LABEL != ''"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- LOOKUP CONNECTE : REF_DEPARTEMENT (pour comparaison)          -->
    <!-- Ce lookup EST connecte - syntaxe classique avec port de flux  -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Lookup Procedure" NAME="LKP_REF_DEPT" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO"
                    DESCRIPTION="CONNECTE - lookup departement avec port de flux direct">
      <TRANSFORMFIELD DATATYPE="string"    NAME="IN_DEPT_CODE"    PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="DEPT_LABEL"      PRECISION="50" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="DIRECTION_CODE"  PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TABLEATTRIBUTE NAME="Lookup table name"     VALUE="REF_DEPARTEMENT"/>
      <TABLEATTRIBUTE NAME="Lookup Condition"      VALUE="IN_DEPT_CODE = DEPT_CODE"/>
      <TABLEATTRIBUTE NAME="Lookup Policy On Multiple Match" VALUE="Return First Row"/>
      <!-- PAS de UNCONNECTED - port connecte directement au flux -->
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- TARGET : DIM_EMPLOYES                                         -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Target Definition" NAME="TGT_DIM_EMPLOYES" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO">
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="EMP_ID"              PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="NOM_CLEAN"           PRECISION="100" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="PRENOM_CLEAN"        PRECISION="100" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="DEPT_CODE"           PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="DEPT_LABEL"          PRECISION="50" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="DIRECTION_CODE"      PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="COUNTRY_CODE"        PRECISION="3"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="PAYS_LABEL"          PRECISION="50" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="ZONE_GEO"            PRECISION="20" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="GRADE"               PRECISION="5"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="GRADE_LABEL"         PRECISION="30" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CONTRAT_TYPE"        PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CONTRAT_LABEL"       PRECISION="30" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="SALAIRE"             PRECISION="12" SCALE="2" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="SALAIRE_BRUT_AJUSTE" PRECISION="14" SCALE="2" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="RETENUE_FISCALE"     PRECISION="12" SCALE="2" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="SALAIRE_NET"         PRECISION="14" SCALE="2" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="FISCAL_RATE"         PRECISION="5"  SCALE="4" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="COEFF_ANCIENNETE"    PRECISION="5"  SCALE="4" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="ANCIENNETE_ANS"      PRECISION="5"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="DATE_EMBAUCHE"       PRECISION="29" SCALE="9" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="BATCH_DATE"          PRECISION="29" SCALE="9" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="DW_LOAD_DATE"        PRECISION="29" SCALE="9" PORTTYPE="INPUT"/>
    </TRANSFORMATION>

    <!-- CONNECTORS -->
    <CONNECTOR FROMTRANSFORMATION="SQ_EMPLOYES"    FROMFIELD="EMP_ID"       TOTRANSFORMATION="EXP_EMP_ENRICH" TOFIELD="EMP_ID"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_EMPLOYES"    FROMFIELD="NOM"          TOTRANSFORMATION="EXP_EMP_ENRICH" TOFIELD="NOM"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_EMPLOYES"    FROMFIELD="PRENOM"       TOTRANSFORMATION="EXP_EMP_ENRICH" TOFIELD="PRENOM"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_EMPLOYES"    FROMFIELD="DEPT_CODE"    TOTRANSFORMATION="EXP_EMP_ENRICH" TOFIELD="DEPT_CODE"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_EMPLOYES"    FROMFIELD="COUNTRY_CODE" TOTRANSFORMATION="EXP_EMP_ENRICH" TOFIELD="COUNTRY_CODE"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_EMPLOYES"    FROMFIELD="SITE_CODE"    TOTRANSFORMATION="EXP_EMP_ENRICH" TOFIELD="SITE_CODE"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_EMPLOYES"    FROMFIELD="SALAIRE"      TOTRANSFORMATION="EXP_EMP_ENRICH" TOFIELD="SALAIRE"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_EMPLOYES"    FROMFIELD="GRADE"        TOTRANSFORMATION="EXP_EMP_ENRICH" TOFIELD="GRADE"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_EMPLOYES"    FROMFIELD="CONTRAT_TYPE" TOTRANSFORMATION="EXP_EMP_ENRICH" TOFIELD="CONTRAT_TYPE"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_EMPLOYES"    FROMFIELD="DATE_EMBAUCHE" TOTRANSFORMATION="EXP_EMP_ENRICH" TOFIELD="DATE_EMBAUCHE"/>
    <!-- Lookup connecte departement -->
    <CONNECTOR FROMTRANSFORMATION="SQ_EMPLOYES"    FROMFIELD="DEPT_CODE"    TOTRANSFORMATION="LKP_REF_DEPT"    TOFIELD="IN_DEPT_CODE"/>
    <!-- EXP → FIL → TGT -->
    <CONNECTOR FROMTRANSFORMATION="EXP_EMP_ENRICH" FROMFIELD="PAYS_LABEL"   TOTRANSFORMATION="FIL_PAYS_CONNU"  TOFIELD="PAYS_LABEL"/>
    <CONNECTOR FROMTRANSFORMATION="FIL_PAYS_CONNU" FROMFIELD="PAYS_LABEL"   TOTRANSFORMATION="TGT_DIM_EMPLOYES" TOFIELD="PAYS_LABEL"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_EMP_ENRICH" FROMFIELD="EMP_ID"             TOTRANSFORMATION="TGT_DIM_EMPLOYES" TOFIELD="EMP_ID"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_EMP_ENRICH" FROMFIELD="NOM_CLEAN"          TOTRANSFORMATION="TGT_DIM_EMPLOYES" TOFIELD="NOM_CLEAN"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_EMP_ENRICH" FROMFIELD="PRENOM_CLEAN"       TOTRANSFORMATION="TGT_DIM_EMPLOYES" TOFIELD="PRENOM_CLEAN"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_EMP_ENRICH" FROMFIELD="DEPT_CODE"          TOTRANSFORMATION="TGT_DIM_EMPLOYES" TOFIELD="DEPT_CODE"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_EMP_ENRICH" FROMFIELD="COUNTRY_CODE"       TOTRANSFORMATION="TGT_DIM_EMPLOYES" TOFIELD="COUNTRY_CODE"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_EMP_ENRICH" FROMFIELD="ZONE_GEO"           TOTRANSFORMATION="TGT_DIM_EMPLOYES" TOFIELD="ZONE_GEO"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_EMP_ENRICH" FROMFIELD="GRADE"              TOTRANSFORMATION="TGT_DIM_EMPLOYES" TOFIELD="GRADE"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_EMP_ENRICH" FROMFIELD="GRADE_LABEL"        TOTRANSFORMATION="TGT_DIM_EMPLOYES" TOFIELD="GRADE_LABEL"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_EMP_ENRICH" FROMFIELD="CONTRAT_TYPE"       TOTRANSFORMATION="TGT_DIM_EMPLOYES" TOFIELD="CONTRAT_TYPE"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_EMP_ENRICH" FROMFIELD="CONTRAT_LABEL"      TOTRANSFORMATION="TGT_DIM_EMPLOYES" TOFIELD="CONTRAT_LABEL"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_EMP_ENRICH" FROMFIELD="SALAIRE"            TOTRANSFORMATION="TGT_DIM_EMPLOYES" TOFIELD="SALAIRE"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_EMP_ENRICH" FROMFIELD="SALAIRE_BRUT_AJUSTE" TOTRANSFORMATION="TGT_DIM_EMPLOYES" TOFIELD="SALAIRE_BRUT_AJUSTE"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_EMP_ENRICH" FROMFIELD="RETENUE_FISCALE"    TOTRANSFORMATION="TGT_DIM_EMPLOYES" TOFIELD="RETENUE_FISCALE"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_EMP_ENRICH" FROMFIELD="SALAIRE_NET"        TOTRANSFORMATION="TGT_DIM_EMPLOYES" TOFIELD="SALAIRE_NET"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_EMP_ENRICH" FROMFIELD="FISCAL_RATE"        TOTRANSFORMATION="TGT_DIM_EMPLOYES" TOFIELD="FISCAL_RATE"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_EMP_ENRICH" FROMFIELD="COEFF_ANCIENNETE"   TOTRANSFORMATION="TGT_DIM_EMPLOYES" TOFIELD="COEFF_ANCIENNETE"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_EMP_ENRICH" FROMFIELD="ANCIENNETE_ANS"     TOTRANSFORMATION="TGT_DIM_EMPLOYES" TOFIELD="ANCIENNETE_ANS"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_EMP_ENRICH" FROMFIELD="DATE_EMBAUCHE"      TOTRANSFORMATION="TGT_DIM_EMPLOYES" TOFIELD="DATE_EMBAUCHE"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_EMP_ENRICH" FROMFIELD="BATCH_DATE_OUT"     TOTRANSFORMATION="TGT_DIM_EMPLOYES" TOFIELD="BATCH_DATE"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_EMP_ENRICH" FROMFIELD="DW_LOAD_DATE"       TOTRANSFORMATION="TGT_DIM_EMPLOYES" TOFIELD="DW_LOAD_DATE"/>
    <CONNECTOR FROMTRANSFORMATION="LKP_REF_DEPT"   FROMFIELD="DEPT_LABEL"         TOTRANSFORMATION="TGT_DIM_EMPLOYES" TOFIELD="DEPT_LABEL"/>
    <CONNECTOR FROMTRANSFORMATION="LKP_REF_DEPT"   FROMFIELD="DIRECTION_CODE"     TOTRANSFORMATION="TGT_DIM_EMPLOYES" TOFIELD="DIRECTION_CODE"/>

    <MAPPINGVARIABLE NAME="$$BATCH_DATE"        DATATYPE="string" DEFAULTVALUE="2026-06-24"/>
    <MAPPINGVARIABLE NAME="$$EMP_FILE"          DATATYPE="string" DEFAULTVALUE="data/employes.csv"/>
    <MAPPINGVARIABLE NAME="$$REF_PAYS_FILE"     DATATYPE="string" DEFAULTVALUE="data/ref_pays.csv"/>
    <MAPPINGVARIABLE NAME="$$REF_GRADE_FILE"    DATATYPE="string" DEFAULTVALUE="data/ref_grade_coeff.csv"/>
    <MAPPINGVARIABLE NAME="$$REF_DEPT_FILE"     DATATYPE="string" DEFAULTVALUE="data/ref_departement.csv"/>
    <MAPPINGVARIABLE NAME="$$OUTPUT_FILE"       DATATYPE="string" DEFAULTVALUE="output/dim_employes.csv"/>
  </MAPPING>

  <WORKFLOW NAME="wf_unconnected_lkp" ISVALID="YES" SERVERNAME="INT_SERVER"
            DESCRIPTION="Test lookup non connecte (:LKP. syntax) - MEDIUM/HIGH - defi traduction apply() vs merge()">
    <WORKFLOWATTRIBUTE AUTOSCHED="NO" AUTOTERM="YES" CONCURRENT="NO" MAXERRORS="1"/>
    <SESSION NAME="s_unconnected_lkp" ISVALID="YES" REUSABLE="NO" MAPPINGNAME="m_unconnected_lkp">
      <SESSIONATTRIBUTE NAME="$Source connection value" VALUE="SRC_ORACLE_PROD"/>
      <SESSIONATTRIBUTE NAME="$Target connection value" VALUE="TGT_DWH"/>
    </SESSION>
  </WORKFLOW>

</FOLDER>
</REPOSITORY>
</POWERMART>
