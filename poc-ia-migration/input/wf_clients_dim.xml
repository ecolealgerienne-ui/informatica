      <TRANSFORMFIELD DATATYPE="nstring" NAME="SEGMENT_CODE" PORTTYPE="OUTPUT"
                      PRECISION="5" SCALE="0"/>
      <TRANSFORMFIELD DATATYPE="nstring" NAME="PAYS_CODE" PORTTYPE="OUTPUT"
                      PRECISION="3" SCALE="0"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="DATE_MAJ" PORTTYPE="OUTPUT"
                      PRECISION="19" SCALE="0"/>
      <TABLEATTRIBUTE NAME="Sql Query"
                      VALUE="SELECT CLIENT_ID, NOM, PRENOM, DATE_NAISSANCE,
                             STATUT_CODE, DATE_CREATION, EMAIL, SEGMENT_CODE,
                             PAYS_CODE, DATE_MAJ
                             FROM DW_OWNER.CLIENTS
                             WHERE DATE_MAJ &gt;= TO_DATE(&apos;$$BATCH_DATE&apos;,&apos;YYYY-MM-DD&apos;)
                             AND ROWNUM &lt;= 1000000"/>
      <TABLEATTRIBUTE NAME="Tracing Level" VALUE="Normal"/>
      <TABLEATTRIBUTE NAME="Select Distinct" VALUE="NO"/>
    </TRANSFORMATION>

