    <CONNECTOR FROMTRANSFORMATION="RTR_SCD2_ACTION" FROMFIELD="DW_LOAD_DATE"      FROMGROUP="GRP_INSERT" TOTRANSFORMATION="TGT_DIM_ACCOUNTS_INSERT" TOFIELD="DW_LOAD_DATE"/>
