      <TRANSFORMFIELD DATATYPE="decimal"   NAME="SALE_ID"        PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="CLIENT_ID"      PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="PRODUCT_ID"     PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="AMOUNT"         PRECISION="12" SCALE="2" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="SALE_DATE"      PRECISION="29" SCALE="9" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="REGION_CODE"    PRECISION="5"  SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="PRODUCT_FAMILY" PRECISION="20" SCALE="0" PORTTYPE="OUTPUT"/>
      <TABLEATTRIBUTE NAME="Sql Query" VALUE="SELECT SALE_ID, CLIENT_ID, PRODUCT_ID, AMOUNT, SALE_DATE, REGION_CODE, PRODUCT_FAMILY FROM SALES_OFFLINE WHERE TRUNC(SALE_DATE, 'MM') = TRUNC(TO_DATE('$$BATCH_DATE', 'YYYY-MM-DD'), 'MM')"/>
      <TABLEATTRIBUTE NAME="Source Table" VALUE="SALES_OFFLINE"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- UNION : FUSION DES DEUX CANAUX                                -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Union" NAME="UNION_SALES" ISVALID="YES"
