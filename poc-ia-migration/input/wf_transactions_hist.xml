<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE POWERMART SYSTEM "powrmart.dtd">
<POWERMART CREATION_DATE="06/24/2026 08:00:00" REPOSITORY_VERSION="184.94">
<REPOSITORY NAME="REP_PROD" VERSION="184" CODEPAGE="UTF-8" DATABASETYPE="Oracle">
<FOLDER NAME="MIGRATION_POC" GROUP="" OWNER="etl_dev" SHARED="NOTSHARED" DESCRIPTION="POC Migration" PERMISSIONS="rwx---r--">

  <MAPPING NAME="m_transactions_hist" ISVALID="YES" OBJECTVERSION="1" VERSIONNUMBER="1"
           DESCRIPTION="Historique transactions financieres avec scoring risque et deduplication - CRITICAL complexity">

    <!-- ============================================================ -->
    <!-- SOURCE 1 : TRANSACTIONS PRINCIPALES                           -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Source Qualifier" NAME="SQ_TRANSACTIONS" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO" DESCRIPTION="Extraction transactions avec sous-requete ROWNUM">
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="TXN_ID"          PRECISION="15" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="ACCOUNT_ID"      PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="COUNTERPART_ID"  PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="TXN_TYPE"        PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="TXN_STATUS"      PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="AMOUNT"          PRECISION="16" SCALE="4" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CURRENCY_CODE"   PRECISION="3"  SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="AMOUNT_EUR"      PRECISION="16" SCALE="4" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="TXN_DATE"        PRECISION="29" SCALE="9" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="VALUE_DATE"      PRECISION="29" SCALE="9" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CHANNEL"         PRECISION="20" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="COUNTRY_ORIGIN"  PRECISION="3"  SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="COUNTRY_DEST"    PRECISION="3"  SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="REF_EXTERNE"     PRECISION="50" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="BATCH_SEQ"       PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TABLEATTRIBUTE NAME="Sql Query" VALUE="SELECT TXN_ID, ACCOUNT_ID, COUNTERPART_ID, TXN_TYPE, TXN_STATUS, AMOUNT, CURRENCY_CODE, AMOUNT_EUR, TXN_DATE, VALUE_DATE, CHANNEL, COUNTRY_ORIGIN, COUNTRY_DEST, REF_EXTERNE, ROWNUM AS BATCH_SEQ FROM (SELECT T.* FROM TRANSACTIONS T WHERE T.TXN_DATE &gt;= TO_DATE('$$BATCH_DATE', 'YYYY-MM-DD') AND T.TXN_STATUS IN ('COMPLETED', 'PENDING_REVIEW') AND T.AMOUNT_EUR IS NOT NULL ORDER BY T.TXN_DATE, T.TXN_ID) WHERE ROWNUM &lt;= $$MAX_ROWS"/>
      <TABLEATTRIBUTE NAME="Source Table" VALUE="TRANSACTIONS"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- SOURCE 2 : HISTORIQUE SCORING (rolling 90 jours)              -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Source Qualifier" NAME="SQ_SCORING_HIST" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO" DESCRIPTION="Historique scoring risque 90 derniers jours par compte">
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="ACCOUNT_ID"      PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="AVG_AMOUNT_90D"  PRECISION="16" SCALE="4" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="MAX_AMOUNT_90D"  PRECISION="16" SCALE="4" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="TXN_COUNT_90D"   PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="COUNTRIES_90D"   PRECISION="5"  SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="PREV_RISK_SCORE" PRECISION="5"  SCALE="0" PORTTYPE="OUTPUT"/>
      <TABLEATTRIBUTE NAME="Sql Query" VALUE="SELECT ACCOUNT_ID, AVG(AMOUNT_EUR) AS AVG_AMOUNT_90D, MAX(AMOUNT_EUR) AS MAX_AMOUNT_90D, COUNT(*) AS TXN_COUNT_90D, COUNT(DISTINCT COUNTRY_DEST) AS COUNTRIES_90D, MAX(RISK_SCORE) AS PREV_RISK_SCORE FROM TRANSACTIONS WHERE TXN_DATE &gt;= SYSDATE - 90 AND TXN_STATUS = 'COMPLETED' GROUP BY ACCOUNT_ID"/>
      <TABLEATTRIBUTE NAME="Source Table" VALUE="TRANSACTIONS"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- SOURCE 3 : LISTE NOIRE PAYS (sanctions)                       -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Source Qualifier" NAME="SQ_BLACKLIST_COUNTRIES" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO" DESCRIPTION="Pays sous sanctions ou surveillance">
      <TRANSFORMFIELD DATATYPE="string"    NAME="COUNTRY_CODE"    PRECISION="3"  SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="SANCTION_LEVEL"  PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="WATCHLIST_FLAG"  PRECISION="1"  SCALE="0" PORTTYPE="OUTPUT"/>
      <TABLEATTRIBUTE NAME="Sql Query" VALUE="SELECT COUNTRY_CODE, SANCTION_LEVEL, WATCHLIST_FLAG FROM REF_BLACKLIST_COUNTRIES WHERE ACTIVE_FLAG = 'Y' AND EFFECTIVE_DATE &lt;= SYSDATE"/>
      <TABLEATTRIBUTE NAME="Source Table" VALUE="REF_BLACKLIST_COUNTRIES"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- JOINER 1 : TXN + SCORING HISTORIQUE                           -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Joiner" NAME="JNR_TXN_SCORING" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO" DESCRIPTION="Jointure transactions et historique scoring">
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="TXN_ID"          PRECISION="15" SCALE="0" PORTTYPE="INPUT" INPUTFROMTRANSFORMATION="SQ_TRANSACTIONS"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="ACCOUNT_ID"      PRECISION="10" SCALE="0" PORTTYPE="INPUT" INPUTFROMTRANSFORMATION="SQ_TRANSACTIONS"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="COUNTERPART_ID"  PRECISION="10" SCALE="0" PORTTYPE="INPUT" INPUTFROMTRANSFORMATION="SQ_TRANSACTIONS"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="TXN_TYPE"        PRECISION="10" SCALE="0" PORTTYPE="INPUT" INPUTFROMTRANSFORMATION="SQ_TRANSACTIONS"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="TXN_STATUS"      PRECISION="10" SCALE="0" PORTTYPE="INPUT" INPUTFROMTRANSFORMATION="SQ_TRANSACTIONS"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="AMOUNT"          PRECISION="16" SCALE="4" PORTTYPE="INPUT" INPUTFROMTRANSFORMATION="SQ_TRANSACTIONS"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CURRENCY_CODE"   PRECISION="3"  SCALE="0" PORTTYPE="INPUT" INPUTFROMTRANSFORMATION="SQ_TRANSACTIONS"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="AMOUNT_EUR"      PRECISION="16" SCALE="4" PORTTYPE="INPUT" INPUTFROMTRANSFORMATION="SQ_TRANSACTIONS"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="TXN_DATE"        PRECISION="29" SCALE="9" PORTTYPE="INPUT" INPUTFROMTRANSFORMATION="SQ_TRANSACTIONS"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="VALUE_DATE"      PRECISION="29" SCALE="9" PORTTYPE="INPUT" INPUTFROMTRANSFORMATION="SQ_TRANSACTIONS"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CHANNEL"         PRECISION="20" SCALE="0" PORTTYPE="INPUT" INPUTFROMTRANSFORMATION="SQ_TRANSACTIONS"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="COUNTRY_ORIGIN"  PRECISION="3"  SCALE="0" PORTTYPE="INPUT" INPUTFROMTRANSFORMATION="SQ_TRANSACTIONS"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="COUNTRY_DEST"    PRECISION="3"  SCALE="0" PORTTYPE="INPUT" INPUTFROMTRANSFORMATION="SQ_TRANSACTIONS"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="REF_EXTERNE"     PRECISION="50" SCALE="0" PORTTYPE="INPUT" INPUTFROMTRANSFORMATION="SQ_TRANSACTIONS"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="BATCH_SEQ"       PRECISION="10" SCALE="0" PORTTYPE="INPUT" INPUTFROMTRANSFORMATION="SQ_TRANSACTIONS"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="S_ACCOUNT_ID"    PRECISION="10" SCALE="0" PORTTYPE="INPUT" INPUTFROMTRANSFORMATION="SQ_SCORING_HIST"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="AVG_AMOUNT_90D"  PRECISION="16" SCALE="4" PORTTYPE="INPUT" INPUTFROMTRANSFORMATION="SQ_SCORING_HIST"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="MAX_AMOUNT_90D"  PRECISION="16" SCALE="4" PORTTYPE="INPUT" INPUTFROMTRANSFORMATION="SQ_SCORING_HIST"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="TXN_COUNT_90D"   PRECISION="10" SCALE="0" PORTTYPE="INPUT" INPUTFROMTRANSFORMATION="SQ_SCORING_HIST"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="COUNTRIES_90D"   PRECISION="5"  SCALE="0" PORTTYPE="INPUT" INPUTFROMTRANSFORMATION="SQ_SCORING_HIST"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="PREV_RISK_SCORE" PRECISION="5"  SCALE="0" PORTTYPE="INPUT" INPUTFROMTRANSFORMATION="SQ_SCORING_HIST"/>
      <TABLEATTRIBUTE NAME="Join Type"      VALUE="Left Outer Join"/>
      <TABLEATTRIBUTE NAME="Join Condition" VALUE="ACCOUNT_ID = S_ACCOUNT_ID"/>
      <TABLEATTRIBUTE NAME="Master Source"  VALUE="SQ_SCORING_HIST"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- LOOKUP : PAYS BLACKLIST ORIGINE                                -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Lookup Procedure" NAME="LKP_BLACKLIST_ORIGIN" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO" DESCRIPTION="Verifie si pays origine est sous sanctions">
      <TRANSFORMFIELD DATATYPE="string"    NAME="IN_COUNTRY"         PRECISION="3"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="ORIGIN_SANCTION_LVL" PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="ORIGIN_WATCHLIST"   PRECISION="1"  SCALE="0" PORTTYPE="OUTPUT"/>
      <TABLEATTRIBUTE NAME="Lookup table name" VALUE="REF_BLACKLIST_COUNTRIES"/>
      <TABLEATTRIBUTE NAME="Lookup Condition"  VALUE="IN_COUNTRY = COUNTRY_CODE"/>
      <TABLEATTRIBUTE NAME="Lookup Policy On Multiple Match" VALUE="Return First Row"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- LOOKUP : PAYS BLACKLIST DESTINATION                            -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Lookup Procedure" NAME="LKP_BLACKLIST_DEST" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO" DESCRIPTION="Verifie si pays destination est sous sanctions">
      <TRANSFORMFIELD DATATYPE="string"    NAME="IN_COUNTRY_DEST"    PRECISION="3"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="DEST_SANCTION_LVL"  PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="DEST_WATCHLIST"     PRECISION="1"  SCALE="0" PORTTYPE="OUTPUT"/>
      <TABLEATTRIBUTE NAME="Lookup table name" VALUE="REF_BLACKLIST_COUNTRIES"/>
      <TABLEATTRIBUTE NAME="Lookup Condition"  VALUE="IN_COUNTRY_DEST = COUNTRY_CODE"/>
      <TABLEATTRIBUTE NAME="Lookup Policy On Multiple Match" VALUE="Return First Row"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- EXPRESSION : SCORING RISQUE COMPOSITE                         -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Expression" NAME="EXP_RISK_SCORING" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO"
                    DESCRIPTION="Calcul score risque composite multi-criteres : montant, frequence, pays, historique">
      <!-- Inputs -->
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="TXN_ID"             PRECISION="15" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="ACCOUNT_ID"         PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="COUNTERPART_ID"     PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="TXN_TYPE"           PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="TXN_STATUS"         PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="AMOUNT_EUR"         PRECISION="16" SCALE="4" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CURRENCY_CODE"      PRECISION="3"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="TXN_DATE"           PRECISION="29" SCALE="9" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="VALUE_DATE"         PRECISION="29" SCALE="9" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CHANNEL"            PRECISION="20" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="COUNTRY_ORIGIN"     PRECISION="3"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="COUNTRY_DEST"       PRECISION="3"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="REF_EXTERNE"        PRECISION="50" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="AVG_AMOUNT_90D"     PRECISION="16" SCALE="4" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="MAX_AMOUNT_90D"     PRECISION="16" SCALE="4" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="TXN_COUNT_90D"      PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="COUNTRIES_90D"      PRECISION="5"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="PREV_RISK_SCORE"    PRECISION="5"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="ORIGIN_SANCTION_LVL" PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="ORIGIN_WATCHLIST"   PRECISION="1"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="DEST_SANCTION_LVL"  PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="DEST_WATCHLIST"     PRECISION="1"  SCALE="0" PORTTYPE="INPUT"/>
      <!-- Outputs : composantes du score -->
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="SCORE_MONTANT"      PRECISION="5"  SCALE="2" PORTTYPE="OUTPUT"
                      EXPRESSION="IIF(AMOUNT_EUR &gt; 100000, 40, IIF(AMOUNT_EUR &gt; 50000, 25, IIF(AMOUNT_EUR &gt; 10000, 15, IIF(AMOUNT_EUR &gt; 1000, 5, 0))))"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="SCORE_FREQUENCE"    PRECISION="5"  SCALE="2" PORTTYPE="OUTPUT"
                      EXPRESSION="IIF(TXN_COUNT_90D &gt; 100, 20, IIF(TXN_COUNT_90D &gt; 50, 15, IIF(TXN_COUNT_90D &gt; 20, 10, IIF(TXN_COUNT_90D &gt; 10, 5, 0))))"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="SCORE_PAYS"         PRECISION="5"  SCALE="2" PORTTYPE="OUTPUT"
                      EXPRESSION="IIF(ORIGIN_SANCTION_LVL = 'EMBARGO', 50, IIF(DEST_SANCTION_LVL = 'EMBARGO', 50, IIF(ORIGIN_SANCTION_LVL = 'HIGH' OR DEST_SANCTION_LVL = 'HIGH', 30, IIF(ORIGIN_WATCHLIST = 'Y' OR DEST_WATCHLIST = 'Y', 15, IIF(COUNTRIES_90D &gt; 10, 10, 0)))))"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="SCORE_DEVIATION"    PRECISION="5"  SCALE="2" PORTTYPE="OUTPUT"
                      EXPRESSION="IIF(NOT ISNULL(AVG_AMOUNT_90D) AND AVG_AMOUNT_90D &gt; 0, IIF(AMOUNT_EUR &gt; AVG_AMOUNT_90D * 5, 25, IIF(AMOUNT_EUR &gt; AVG_AMOUNT_90D * 3, 15, IIF(AMOUNT_EUR &gt; AVG_AMOUNT_90D * 2, 8, 0))), 0)"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="SCORE_TOTAL"        PRECISION="6"  SCALE="2" PORTTYPE="OUTPUT"
                      EXPRESSION="SCORE_MONTANT + SCORE_FREQUENCE + SCORE_PAYS + SCORE_DEVIATION"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="RISK_LEVEL"         PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="IIF(SCORE_TOTAL &gt;= 80, 'CRITIQUE', IIF(SCORE_TOTAL &gt;= 50, 'ELEVE', IIF(SCORE_TOTAL &gt;= 25, 'MOYEN', IIF(SCORE_TOTAL &gt;= 10, 'FAIBLE', 'NEGLIGEABLE'))))"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="ALERT_FLAG"         PRECISION="1"  SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="IIF(SCORE_TOTAL &gt;= 50 OR ORIGIN_SANCTION_LVL = 'EMBARGO' OR DEST_SANCTION_LVL = 'EMBARGO', 'Y', 'N')"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="VALUE_DATE_LAG_DAYS" PRECISION="5" SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="DATEDIFF(VALUE_DATE, TXN_DATE, 'DD')"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="TXN_TYPE_LABEL"     PRECISION="30" SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="DECODE(TXN_TYPE, 'WIRE', 'Virement international', 'SEPA', 'Virement SEPA', 'CARD', 'Paiement carte', 'CASH', 'Operation especes', 'CHQE', 'Cheque', 'Autre')"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CHANNEL_CLEAN"      PRECISION="20" SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="LTRIM(RTRIM(UPPER(CHANNEL)))"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="REF_EXTERNE_HASH"   PRECISION="64" SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="IIF(ISNULL(REF_EXTERNE) OR LTRIM(RTRIM(REF_EXTERNE)) = '', 'NO_REF_' || TO_CHAR(TXN_ID), LTRIM(RTRIM(UPPER(REF_EXTERNE))))"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="DW_LOAD_DATE"       PRECISION="29" SCALE="9" PORTTYPE="OUTPUT"
                      EXPRESSION="SYSDATE"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="BATCH_DATE_OUT"     PRECISION="29" SCALE="9" PORTTYPE="OUTPUT"
                      EXPRESSION="TO_DATE($$BATCH_DATE, 'YYYY-MM-DD')"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- SORTER : TRI POUR DEDUP PAR REF_EXTERNE                       -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Sorter" NAME="SRT_DEDUP_REF" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO" DESCRIPTION="Tri pour deduplication par reference externe">
      <TRANSFORMFIELD DATATYPE="string"    NAME="REF_EXTERNE_HASH"  PRECISION="64" SCALE="0" PORTTYPE="INPUT" SORTORDER="Ascending"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="TXN_DATE"          PRECISION="29" SCALE="9" PORTTYPE="INPUT" SORTORDER="Descending"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="TXN_ID"            PRECISION="15" SCALE="0" PORTTYPE="INPUT" SORTORDER="Descending"/>
      <TABLEATTRIBUTE NAME="Distinct Rows"   VALUE="NO"/>
      <TABLEATTRIBUTE NAME="Case Sensitive"  VALUE="YES"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- EXPRESSION : DEDUPLICATION (garder premiere occurrence)        -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Expression" NAME="EXP_DEDUP" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO" DESCRIPTION="Deduplication sur REF_EXTERNE - garde la transaction la plus recente">
      <TRANSFORMFIELD DATATYPE="string"    NAME="REF_EXTERNE_HASH"  PRECISION="64" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="TXN_ID"            PRECISION="15" SCALE="0" PORTTYPE="INPUT"/>
      <!-- Variable locale pour comparaison -->
      <TRANSFORMFIELD DATATYPE="string"    NAME="IS_DUPLICATE"      PRECISION="1"  SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="IIF(REF_EXTERNE_HASH = v_prev_ref AND NOT ISNULL(v_prev_ref), 'Y', 'N')"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="v_prev_ref"        PRECISION="64" SCALE="0" PORTTYPE="LOCAL_VARIABLE"
                      EXPRESSION="REF_EXTERNE_HASH"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- FILTER : EXCLURE LES DOUBLONS                                 -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Filter" NAME="FIL_REMOVE_DUPLICATES" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO" DESCRIPTION="Elimination des doublons detectes">
      <TRANSFORMFIELD DATATYPE="string"    NAME="IS_DUPLICATE"      PRECISION="1"  SCALE="0" PORTTYPE="INPUT"/>
      <TABLEATTRIBUTE NAME="Filter Condition" VALUE="IS_DUPLICATE = 'N'"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- ROUTER : ALERTE vs NORMAL                                     -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Router" NAME="RTR_ALERT_SPLIT" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO" DESCRIPTION="Separe transactions en alerte des transactions normales">
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="TXN_ID"            PRECISION="15" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="ACCOUNT_ID"        PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="COUNTERPART_ID"    PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="TXN_TYPE"          PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="TXN_TYPE_LABEL"    PRECISION="30" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="TXN_STATUS"        PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="AMOUNT_EUR"        PRECISION="16" SCALE="4" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CURRENCY_CODE"     PRECISION="3"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="TXN_DATE"          PRECISION="29" SCALE="9" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="VALUE_DATE"        PRECISION="29" SCALE="9" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CHANNEL_CLEAN"     PRECISION="20" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="COUNTRY_ORIGIN"    PRECISION="3"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="COUNTRY_DEST"      PRECISION="3"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="REF_EXTERNE_HASH"  PRECISION="64" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="SCORE_TOTAL"       PRECISION="6"  SCALE="2" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="RISK_LEVEL"        PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="ALERT_FLAG"        PRECISION="1"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="SCORE_MONTANT"     PRECISION="5"  SCALE="2" PORTTYPE="INPUT"/>
