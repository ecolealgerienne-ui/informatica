                      EXPRESSION="NOM" EXPRESSIONTYPE="GENERAL"
                      NAME="NOM" PORTTYPE="INPUT"
                      PRECISION="100" SCALE="0"/>
      <TRANSFORMFIELD DATATYPE="string" DEFAULTVALUE="" DESCRIPTION=""
                      EXPRESSION="LTRIM(RTRIM(UPPER(NOM)))"
                      EXPRESSIONTYPE="GENERAL"
                      NAME="NOM_CLEAN" PORTTYPE="OUTPUT"
                      PRECISION="100" SCALE="0"/>
    </TRANSFORMATION>

    <!-- Target Instance -->
    <TRANSFORMATION DESCRIPTION="" NAME="TGT_EMPLOYES_CLEAN"
                    OBJECTVERSION="1" REUSABLE="NO"
                    TYPE="Target Definition" VERSIONNUMBER="1">
      <TRANSFORMFIELD DATATYPE="number" DEFAULTVALUE="" DESCRIPTION=""
