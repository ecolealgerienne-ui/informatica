    <CONNECTOR FROMTRANSFORMATION="NRM_BUDGET_MENSUEL" FROMFIELD="BUDGET_MENSUEL"   TOTRANSFORMATION="EXP_BUDGET_CALC" TOFIELD="BUDGET_MENSUEL"/>
    <CONNECTOR FROMTRANSFORMATION="NRM_BUDGET_MENSUEL" FROMFIELD="REALISE_MENSUEL"  TOTRANSFORMATION="EXP_BUDGET_CALC" TOFIELD="REALISE_MENSUEL"/>
    <CONNECTOR FROMTRANSFORMATION="NRM_BUDGET_MENSUEL" FROMFIELD="GCID_MOIS"        TOTRANSFORMATION="EXP_BUDGET_CALC" TOFIELD="GCID_MOIS"/>
