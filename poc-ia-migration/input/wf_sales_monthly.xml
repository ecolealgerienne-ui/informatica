    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- EXPRESSION : DECODE CATEGORIE + CANAL + RANG                  -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Expression" NAME="EXP_SALES_ENRICH" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO"
                    DESCRIPTION="Enrichissement : DECODE famille produit, derivation canal, periode">
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="SALE_ID"         PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="CLIENT_ID"       PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="PRODUCT_ID"      PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="AMOUNT"          PRECISION="12" SCALE="2" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="SALE_DATE"       PRECISION="29" SCALE="9" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="REGION_CODE"     PRECISION="5"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="PRODUCT_FAMILY"  PRECISION="20" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CHANNEL_SRC"     PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <!-- Outputs -->
      <TRANSFORMFIELD DATATYPE="string"    NAME="FAMILY_LABEL"    PRECISION="50" SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="DECODE(PRODUCT_FAMILY, 'ELEC', 'Electronique', 'FOOD', 'Alimentation', 'CLOT', 'Habillement', 'HOME', 'Maison &amp; Jardin', 'SPRT', 'Sport &amp; Loisirs', 'Autre')"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="FAMILY_SEGMENT"  PRECISION="20" SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="DECODE(PRODUCT_FAMILY, 'ELEC', 'HIGH_TECH', 'FOOD', 'FMCG', 'CLOT', 'FASHION', 'HOME', 'HOME_DECO', 'SPRT', 'LEISURE', 'OTHER')"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="SALE_YEAR"       PRECISION="4"  SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="TO_INTEGER(TO_CHAR(SALE_DATE, 'YYYY'))"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="SALE_MONTH"      PRECISION="2"  SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="TO_INTEGER(TO_CHAR(SALE_DATE, 'MM'))"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="REGION_LABEL"    PRECISION="30" SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="DECODE(REGION_CODE, 'NA', 'Amerique du Nord', 'EU', 'Europe', 'AP', 'Asie-Pacifique', 'ME', 'Moyen-Orient', 'AF', 'Afrique', 'Inconnu')"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="AMOUNT_ROUNDED"  PRECISION="12" SCALE="2" PORTTYPE="OUTPUT"
                      EXPRESSION="ROUND(AMOUNT, 2)"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="DW_LOAD_DATE"    PRECISION="29" SCALE="9" PORTTYPE="OUTPUT"
                      EXPRESSION="SYSDATE"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="BATCH_DATE_OUT"  PRECISION="29" SCALE="9" PORTTYPE="OUTPUT"
                      EXPRESSION="TO_DATE($$BATCH_DATE, 'YYYY-MM-DD')"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- AGGREGATOR : CUMUL MENSUEL PAR FAMILLE/REGION                 -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Aggregator" NAME="AGG_MONTHLY_SALES" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO" DESCRIPTION="Agregation mensuelle par famille produit et region">
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="SALE_YEAR"       PRECISION="4"  SCALE="0" PORTTYPE="INPUT"  AGGREGATEBY="Group By"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="SALE_MONTH"      PRECISION="2"  SCALE="0" PORTTYPE="INPUT"  AGGREGATEBY="Group By"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="REGION_CODE"     PRECISION="5"  SCALE="0" PORTTYPE="INPUT"  AGGREGATEBY="Group By"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="REGION_LABEL"    PRECISION="30" SCALE="0" PORTTYPE="INPUT"  AGGREGATEBY="Group By"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="PRODUCT_FAMILY"  PRECISION="20" SCALE="0" PORTTYPE="INPUT"  AGGREGATEBY="Group By"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="FAMILY_LABEL"    PRECISION="50" SCALE="0" PORTTYPE="INPUT"  AGGREGATEBY="Group By"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="FAMILY_SEGMENT"  PRECISION="20" SCALE="0" PORTTYPE="INPUT"  AGGREGATEBY="Group By"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CHANNEL_SRC"     PRECISION="10" SCALE="0" PORTTYPE="INPUT"  AGGREGATEBY="Group By"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="SALE_COUNT"      PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="COUNT(SALE_ID)" AGGREGATEBY="Count"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="TOTAL_AMOUNT"    PRECISION="16" SCALE="2" PORTTYPE="OUTPUT"
                      EXPRESSION="SUM(AMOUNT_ROUNDED)" AGGREGATEBY="Sum"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="MAX_AMOUNT"      PRECISION="12" SCALE="2" PORTTYPE="OUTPUT"
                      EXPRESSION="MAX(AMOUNT_ROUNDED)" AGGREGATEBY="Max"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="MIN_AMOUNT"      PRECISION="12" SCALE="2" PORTTYPE="OUTPUT"
                      EXPRESSION="MIN(AMOUNT_ROUNDED)" AGGREGATEBY="Min"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="AVG_AMOUNT"      PRECISION="12" SCALE="2" PORTTYPE="OUTPUT"
                      EXPRESSION="AVG(AMOUNT_ROUNDED)" AGGREGATEBY="Avg"/>
      <TABLEATTRIBUTE NAME="Sorted Input" VALUE="YES"/>
    </TRANSFORMATION>

