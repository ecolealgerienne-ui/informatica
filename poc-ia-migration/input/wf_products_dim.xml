<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE POWERMART SYSTEM "powrmart.dtd">
<POWERMART CREATION_DATE="06/24/2026 08:00:00" REPOSITORY_VERSION="184.94">
<REPOSITORY NAME="REP_PROD" VERSION="184" CODEPAGE="UTF-8" DATABASETYPE="Oracle">
<FOLDER NAME="MIGRATION_POC" GROUP="" OWNER="etl_dev" SHARED="NOTSHARED" DESCRIPTION="POC Migration" PERMISSIONS="rwx---r--">

  <MAPPING NAME="m_products_dim" ISVALID="YES" OBJECTVERSION="1" VERSIONNUMBER="1"
           DESCRIPTION="Charge la dimension produits avec normalisation categorie et calcul marge">

    <!-- ============================================================ -->
    <!-- SOURCE : TABLE ORACLE PRODUCTS                                -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Source Qualifier" NAME="SQ_PRODUCTS" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO" DESCRIPTION="Extraction produits actifs">
      <TRANSFORMFIELD DATATYPE="decimal" NAME="PRODUCT_ID"      PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"  NAME="PRODUCT_CODE"    PRECISION="20" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"  NAME="PRODUCT_NAME"    PRECISION="100" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"  NAME="CATEGORY"        PRECISION="50" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"  NAME="SUBCATEGORY"     PRECISION="50" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal" NAME="UNIT_PRICE"      PRECISION="12" SCALE="2" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal" NAME="UNIT_COST"       PRECISION="12" SCALE="2" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"  NAME="SUPPLIER_CODE"   PRECISION="20" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"  NAME="STATUS_CODE"     PRECISION="2"  SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="DATE_CREATION" PRECISION="29" SCALE="9" PORTTYPE="OUTPUT"/>
      <TABLEATTRIBUTE NAME="Sql Query" VALUE="SELECT PRODUCT_ID, PRODUCT_CODE, PRODUCT_NAME, CATEGORY, SUBCATEGORY, UNIT_PRICE, UNIT_COST, SUPPLIER_CODE, STATUS_CODE, DATE_CREATION FROM PRODUCTS WHERE STATUS_CODE != 'D' AND DATE_CREATION &gt;= TO_DATE('$$BATCH_DATE', 'YYYY-MM-DD')"/>
      <TABLEATTRIBUTE NAME="Source Table" VALUE="PRODUCTS"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- LOOKUP : TABLE REF_CATEGORY                                   -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Lookup Procedure" NAME="LKP_CATEGORY" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO" DESCRIPTION="Lookup code categorie normalise">
      <TRANSFORMFIELD DATATYPE="string"  NAME="IN_CATEGORY"      PRECISION="50" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"  NAME="CATEGORY_CODE"    PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"  NAME="CATEGORY_LABEL_FR" PRECISION="100" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"  NAME="CATEGORY_LABEL_EN" PRECISION="100" SCALE="0" PORTTYPE="OUTPUT"/>
      <TABLEATTRIBUTE NAME="Lookup table name" VALUE="REF_CATEGORY"/>
      <TABLEATTRIBUTE NAME="Lookup Condition" VALUE="IN_CATEGORY = CATEGORY_RAW"/>
      <TABLEATTRIBUTE NAME="Lookup Policy On Multiple Match" VALUE="Return First Row"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- EXPRESSION : TRANSFORMATIONS METIER                           -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Expression" NAME="EXP_PRODUCTS_TRANSFORM" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO" DESCRIPTION="Normalisation et calcul marge">
      <!-- Inputs -->
      <TRANSFORMFIELD DATATYPE="decimal" NAME="PRODUCT_ID"      PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"  NAME="PRODUCT_CODE"    PRECISION="20" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"  NAME="PRODUCT_NAME"    PRECISION="100" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"  NAME="CATEGORY"        PRECISION="50" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"  NAME="SUBCATEGORY"     PRECISION="50" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal" NAME="UNIT_PRICE"      PRECISION="12" SCALE="2" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal" NAME="UNIT_COST"       PRECISION="12" SCALE="2" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"  NAME="SUPPLIER_CODE"   PRECISION="20" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"  NAME="STATUS_CODE"     PRECISION="2"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="DATE_CREATION" PRECISION="29" SCALE="9" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"  NAME="CATEGORY_CODE"   PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"  NAME="CATEGORY_LABEL_FR" PRECISION="100" SCALE="0" PORTTYPE="INPUT"/>
      <!-- Outputs calculés -->
      <TRANSFORMFIELD DATATYPE="string"  NAME="PRODUCT_CODE_CLEAN" PRECISION="20" SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="LTRIM(RTRIM(UPPER(PRODUCT_CODE)))"/>
      <TRANSFORMFIELD DATATYPE="string"  NAME="PRODUCT_NAME_CLEAN" PRECISION="100" SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="LTRIM(RTRIM(INITCAP(PRODUCT_NAME)))"/>
      <TRANSFORMFIELD DATATYPE="string"  NAME="SUBCATEGORY_CLEAN" PRECISION="50" SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="LTRIM(RTRIM(UPPER(SUBCATEGORY)))"/>
      <TRANSFORMFIELD DATATYPE="decimal" NAME="MARGIN_PCT"      PRECISION="8"  SCALE="4" PORTTYPE="OUTPUT"
                      EXPRESSION="IIF(UNIT_PRICE &gt; 0, (UNIT_PRICE - UNIT_COST) / UNIT_PRICE * 100, 0)"/>
      <TRANSFORMFIELD DATATYPE="string"  NAME="MARGIN_BAND"     PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="IIF(MARGIN_PCT &gt;= 50, 'HIGH', IIF(MARGIN_PCT &gt;= 20, 'MEDIUM', 'LOW'))"/>
      <TRANSFORMFIELD DATATYPE="string"  NAME="SUPPLIER_CODE_CLEAN" PRECISION="20" SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="LTRIM(RTRIM(UPPER(SUPPLIER_CODE)))"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="BATCH_DATE_OUT" PRECISION="29" SCALE="9" PORTTYPE="OUTPUT"
                      EXPRESSION="TO_DATE($$BATCH_DATE, 'YYYY-MM-DD')"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="DW_LOAD_DATE"  PRECISION="29" SCALE="9" PORTTYPE="OUTPUT"
                      EXPRESSION="SYSDATE"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- FILTER : GARDER SEULEMENT LES PRODUITS AVEC CATEGORIE CONNUE -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Filter" NAME="FIL_VALID_CATEGORY" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO" DESCRIPTION="Filtre produits sans categorie valide">
      <TRANSFORMFIELD DATATYPE="string"  NAME="CATEGORY_CODE"   PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TABLEATTRIBUTE NAME="Filter Condition" VALUE="NOT ISNULL(CATEGORY_CODE) AND CATEGORY_CODE != 'UNKN'"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- TARGET : TABLE DWH DIM_PRODUCTS                               -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Target Definition" NAME="TGT_DIM_PRODUCTS" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO" DESCRIPTION="Table dimension produits DWH">
      <TRANSFORMFIELD DATATYPE="decimal" NAME="PRODUCT_ID"          PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"  NAME="PRODUCT_CODE_CLEAN"  PRECISION="20" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"  NAME="PRODUCT_NAME_CLEAN"  PRECISION="100" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"  NAME="CATEGORY_CODE"       PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"  NAME="CATEGORY_LABEL_FR"   PRECISION="100" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"  NAME="SUBCATEGORY_CLEAN"   PRECISION="50" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal" NAME="UNIT_PRICE"          PRECISION="12" SCALE="2" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal" NAME="UNIT_COST"           PRECISION="12" SCALE="2" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal" NAME="MARGIN_PCT"          PRECISION="8"  SCALE="4" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"  NAME="MARGIN_BAND"         PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"  NAME="SUPPLIER_CODE_CLEAN" PRECISION="20" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"  NAME="STATUS_CODE"         PRECISION="2"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="DATE_CREATION"     PRECISION="29" SCALE="9" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="BATCH_DATE"        PRECISION="29" SCALE="9" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="DW_LOAD_DATE"      PRECISION="29" SCALE="9" PORTTYPE="INPUT"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- CONNECTORS                                                    -->
    <!-- ============================================================ -->
    <CONNECTOR FROMTRANSFORMATION="SQ_PRODUCTS"          FROMFIELD="PRODUCT_ID"      TOTRANSFORMATION="EXP_PRODUCTS_TRANSFORM" TOFIELD="PRODUCT_ID"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_PRODUCTS"          FROMFIELD="PRODUCT_CODE"    TOTRANSFORMATION="EXP_PRODUCTS_TRANSFORM" TOFIELD="PRODUCT_CODE"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_PRODUCTS"          FROMFIELD="PRODUCT_NAME"    TOTRANSFORMATION="EXP_PRODUCTS_TRANSFORM" TOFIELD="PRODUCT_NAME"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_PRODUCTS"          FROMFIELD="CATEGORY"        TOTRANSFORMATION="EXP_PRODUCTS_TRANSFORM" TOFIELD="CATEGORY"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_PRODUCTS"          FROMFIELD="SUBCATEGORY"     TOTRANSFORMATION="EXP_PRODUCTS_TRANSFORM" TOFIELD="SUBCATEGORY"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_PRODUCTS"          FROMFIELD="UNIT_PRICE"      TOTRANSFORMATION="EXP_PRODUCTS_TRANSFORM" TOFIELD="UNIT_PRICE"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_PRODUCTS"          FROMFIELD="UNIT_COST"       TOTRANSFORMATION="EXP_PRODUCTS_TRANSFORM" TOFIELD="UNIT_COST"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_PRODUCTS"          FROMFIELD="SUPPLIER_CODE"   TOTRANSFORMATION="EXP_PRODUCTS_TRANSFORM" TOFIELD="SUPPLIER_CODE"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_PRODUCTS"          FROMFIELD="STATUS_CODE"     TOTRANSFORMATION="EXP_PRODUCTS_TRANSFORM" TOFIELD="STATUS_CODE"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_PRODUCTS"          FROMFIELD="DATE_CREATION"   TOTRANSFORMATION="EXP_PRODUCTS_TRANSFORM" TOFIELD="DATE_CREATION"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_PRODUCTS"          FROMFIELD="CATEGORY"        TOTRANSFORMATION="LKP_CATEGORY"           TOFIELD="IN_CATEGORY"/>
    <CONNECTOR FROMTRANSFORMATION="LKP_CATEGORY"         FROMFIELD="CATEGORY_CODE"   TOTRANSFORMATION="EXP_PRODUCTS_TRANSFORM" TOFIELD="CATEGORY_CODE"/>
    <CONNECTOR FROMTRANSFORMATION="LKP_CATEGORY"         FROMFIELD="CATEGORY_LABEL_FR" TOTRANSFORMATION="EXP_PRODUCTS_TRANSFORM" TOFIELD="CATEGORY_LABEL_FR"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_PRODUCTS_TRANSFORM" FROMFIELD="CATEGORY_CODE" TOTRANSFORMATION="FIL_VALID_CATEGORY"     TOFIELD="CATEGORY_CODE"/>
    <CONNECTOR FROMTRANSFORMATION="FIL_VALID_CATEGORY"   FROMFIELD="CATEGORY_CODE"   TOTRANSFORMATION="TGT_DIM_PRODUCTS"       TOFIELD="CATEGORY_CODE"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_PRODUCTS_TRANSFORM" FROMFIELD="PRODUCT_ID"    TOTRANSFORMATION="TGT_DIM_PRODUCTS"       TOFIELD="PRODUCT_ID"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_PRODUCTS_TRANSFORM" FROMFIELD="PRODUCT_CODE_CLEAN" TOTRANSFORMATION="TGT_DIM_PRODUCTS"  TOFIELD="PRODUCT_CODE_CLEAN"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_PRODUCTS_TRANSFORM" FROMFIELD="PRODUCT_NAME_CLEAN" TOTRANSFORMATION="TGT_DIM_PRODUCTS"  TOFIELD="PRODUCT_NAME_CLEAN"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_PRODUCTS_TRANSFORM" FROMFIELD="CATEGORY_LABEL_FR" TOTRANSFORMATION="TGT_DIM_PRODUCTS"   TOFIELD="CATEGORY_LABEL_FR"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_PRODUCTS_TRANSFORM" FROMFIELD="SUBCATEGORY_CLEAN" TOTRANSFORMATION="TGT_DIM_PRODUCTS"   TOFIELD="SUBCATEGORY_CLEAN"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_PRODUCTS_TRANSFORM" FROMFIELD="UNIT_PRICE"    TOTRANSFORMATION="TGT_DIM_PRODUCTS"       TOFIELD="UNIT_PRICE"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_PRODUCTS_TRANSFORM" FROMFIELD="UNIT_COST"     TOTRANSFORMATION="TGT_DIM_PRODUCTS"       TOFIELD="UNIT_COST"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_PRODUCTS_TRANSFORM" FROMFIELD="MARGIN_PCT"    TOTRANSFORMATION="TGT_DIM_PRODUCTS"       TOFIELD="MARGIN_PCT"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_PRODUCTS_TRANSFORM" FROMFIELD="MARGIN_BAND"   TOTRANSFORMATION="TGT_DIM_PRODUCTS"       TOFIELD="MARGIN_BAND"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_PRODUCTS_TRANSFORM" FROMFIELD="SUPPLIER_CODE_CLEAN" TOTRANSFORMATION="TGT_DIM_PRODUCTS" TOFIELD="SUPPLIER_CODE_CLEAN"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_PRODUCTS_TRANSFORM" FROMFIELD="STATUS_CODE"   TOTRANSFORMATION="TGT_DIM_PRODUCTS"       TOFIELD="STATUS_CODE"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_PRODUCTS_TRANSFORM" FROMFIELD="DATE_CREATION" TOTRANSFORMATION="TGT_DIM_PRODUCTS"       TOFIELD="DATE_CREATION"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_PRODUCTS_TRANSFORM" FROMFIELD="BATCH_DATE_OUT" TOTRANSFORMATION="TGT_DIM_PRODUCTS"      TOFIELD="BATCH_DATE"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_PRODUCTS_TRANSFORM" FROMFIELD="DW_LOAD_DATE"  TOTRANSFORMATION="TGT_DIM_PRODUCTS"       TOFIELD="DW_LOAD_DATE"/>

    <MAPPINGVARIABLE NAME="$$BATCH_DATE"    DATATYPE="string"    DEFAULTVALUE="2026-06-24" DESCRIPTION="Date de traitement du batch"/>
    <MAPPINGVARIABLE NAME="$$SOURCE_FILE"   DATATYPE="string"    DEFAULTVALUE="data/products.csv"/>
    <MAPPINGVARIABLE NAME="$$REF_CAT_FILE"  DATATYPE="string"    DEFAULTVALUE="data/ref_category.csv"/>
    <MAPPINGVARIABLE NAME="$$OUTPUT_FILE"   DATATYPE="string"    DEFAULTVALUE="output/dim_products.csv"/>
  </MAPPING>

  <WORKFLOW NAME="wf_products_dim" ISVALID="YES" SERVERNAME="INT_SERVER"
            DESCRIPTION="Workflow dimension produits - LOW complexity">
    <WORKFLOWATTRIBUTE AUTOSCHED="NO" AUTOTERM="YES" CONCURRENT="NO" MAXERRORS="1"/>
    <SESSION NAME="s_products_dim" ISVALID="YES" REUSABLE="NO" SORTORDER="Session" MAPPINGNAME="m_products_dim">
      <SESSIONATTRIBUTE NAME="$Source connection value"  VALUE="SRC_ORACLE_PROD"/>
      <SESSIONATTRIBUTE NAME="$Target connection value"  VALUE="TGT_DWH"/>
      <SESSIONATTRIBUTE NAME="Treat source rows as"      VALUE="Data Driven"/>
    </SESSION>
  </WORKFLOW>

</FOLDER>
</REPOSITORY>
</POWERMART>
