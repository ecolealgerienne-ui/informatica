  <MAPPING DESCRIPTION="Smoke test — normalisation NOM uniquement"
           ISVALID="YES" NAME="m_smoke_test"
           OBJECTVERSION="1" VERSIONNUMBER="1">

    <!-- Source Qualifier — no SQL override, simple date filter -->
    <TRANSFORMATION DESCRIPTION="Source qualifier — filtre DATE_MAJ >= BATCH_DATE"
