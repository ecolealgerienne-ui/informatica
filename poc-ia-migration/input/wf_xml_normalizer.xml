<!DOCTYPE POWERMART SYSTEM "powrmart.dtd">
<POWERMART CREATION_DATE="06/24/2026 08:00:00" REPOSITORY_VERSION="184.94">
<REPOSITORY NAME="REP_PROD" VERSION="184" CODEPAGE="UTF-8" DATABASETYPE="Oracle">
<FOLDER NAME="MIGRATION_POC" GROUP="" OWNER="etl_dev" SHARED="NOTSHARED" DESCRIPTION="POC Migration" PERMISSIONS="rwx---r--">

  <MAPPING NAME="m_xml_normalizer" ISVALID="YES" OBJECTVERSION="1" VERSIONNUMBER="1"
           DESCRIPTION="Normalizer transformation - unpivot colonnes en lignes via GCID - HIGH complexity">

    <!--
      PATTERN CLE : Normalizer (Unpivot)
      =====================================
      Le Normalizer est utilise pour pivoter des colonnes repetitives en lignes.
      Exemple : une table BUDGET avec 12 colonnes BUDGET_M01..BUDGET_M12
      devient une table avec une ligne par mois (unpivot).

      Le GCID (Generated Column ID) est un index interne Informatica
      qui numerote les occurrences generees (1 a N).

      Defi migration : pd.melt() pour l'unpivot.
      Le GCID devient l'index de position dans le melt.
    -->

    <!-- ============================================================ -->
    <!-- SOURCE : TABLE BUDGET_ANNUEL (colonnes mensuelless)            -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Source Qualifier" NAME="SQ_BUDGET_ANNUEL" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO"
                    DESCRIPTION="Extraction budget annuel avec 12 colonnes mensuelles">
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="BUDGET_ID"       PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="DEPT_CODE"       PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CATEGORIE"       PRECISION="30" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="ANNEE"           PRECISION="4"  SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="BUDGET_M01"      PRECISION="14" SCALE="2" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="BUDGET_M02"      PRECISION="14" SCALE="2" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="BUDGET_M03"      PRECISION="14" SCALE="2" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="BUDGET_M04"      PRECISION="14" SCALE="2" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="BUDGET_M05"      PRECISION="14" SCALE="2" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="BUDGET_M06"      PRECISION="14" SCALE="2" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="BUDGET_M07"      PRECISION="14" SCALE="2" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="BUDGET_M08"      PRECISION="14" SCALE="2" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="BUDGET_M09"      PRECISION="14" SCALE="2" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="BUDGET_M10"      PRECISION="14" SCALE="2" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="BUDGET_M11"      PRECISION="14" SCALE="2" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="BUDGET_M12"      PRECISION="14" SCALE="2" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="REALISE_M01"     PRECISION="14" SCALE="2" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="REALISE_M02"     PRECISION="14" SCALE="2" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="REALISE_M03"     PRECISION="14" SCALE="2" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="REALISE_M04"     PRECISION="14" SCALE="2" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="REALISE_M05"     PRECISION="14" SCALE="2" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="REALISE_M06"     PRECISION="14" SCALE="2" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="REALISE_M07"     PRECISION="14" SCALE="2" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="REALISE_M08"     PRECISION="14" SCALE="2" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="REALISE_M09"     PRECISION="14" SCALE="2" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="REALISE_M10"     PRECISION="14" SCALE="2" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="REALISE_M11"     PRECISION="14" SCALE="2" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="REALISE_M12"     PRECISION="14" SCALE="2" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="STATUT_BUDGET"   PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TABLEATTRIBUTE NAME="Sql Query" VALUE="SELECT BUDGET_ID, DEPT_CODE, CATEGORIE, ANNEE, BUDGET_M01, BUDGET_M02, BUDGET_M03, BUDGET_M04, BUDGET_M05, BUDGET_M06, BUDGET_M07, BUDGET_M08, BUDGET_M09, BUDGET_M10, BUDGET_M11, BUDGET_M12, REALISE_M01, REALISE_M02, REALISE_M03, REALISE_M04, REALISE_M05, REALISE_M06, REALISE_M07, REALISE_M08, REALISE_M09, REALISE_M10, REALISE_M11, REALISE_M12, STATUT_BUDGET FROM BUDGET_ANNUEL WHERE ANNEE = TO_NUMBER(TO_CHAR(TO_DATE('$$BATCH_DATE', 'YYYY-MM-DD'), 'YYYY'))"/>
      <TABLEATTRIBUTE NAME="Source Table" VALUE="BUDGET_ANNUEL"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- NORMALIZER : UNPIVOT 12 MOIS EN LIGNES                        -->
    <!-- GCID = index de l'occurrence (1=M01, 2=M02, ..., 12=M12)     -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Normalizer" NAME="NRM_BUDGET_MENSUEL" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO"
                    DESCRIPTION="Unpivot colonnes BUDGET_M01..M12 et REALISE_M01..M12 en lignes mensuelles">
      <!-- Ports stables (non repetes) -->
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="BUDGET_ID"       PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="DEPT_CODE"       PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CATEGORIE"       PRECISION="30" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="ANNEE"           PRECISION="4"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="STATUT_BUDGET"   PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <!-- Ports repetes : GCID controle le numero d'occurrence -->
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="BUDGET_M"        PRECISION="14" SCALE="2" PORTTYPE="INPUT"
                      OCCURS="12" GCID="GCID_MOIS"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="REALISE_M"       PRECISION="14" SCALE="2" PORTTYPE="INPUT"
                      OCCURS="12" GCID="GCID_MOIS"/>
      <!-- Sorties generees par occurrence -->
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="BUDGET_ID_OUT"   PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="DEPT_CODE_OUT"   PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CATEGORIE_OUT"   PRECISION="30" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="ANNEE_OUT"       PRECISION="4"  SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="STATUT_BUDGET_OUT" PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="BUDGET_MENSUEL"  PRECISION="14" SCALE="2" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="REALISE_MENSUEL" PRECISION="14" SCALE="2" PORTTYPE="OUTPUT"/>
      <!-- GCID : numero de l'occurrence (1..12) = numero du mois -->
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="GCID_MOIS"       PRECISION="2"  SCALE="0" PORTTYPE="OUTPUT"/>
      <TABLEATTRIBUTE NAME="Normalizer Source" VALUE="RELATIONAL"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- EXPRESSION : RECONSTRUCTION DATE MOIS + CALCULS ECART         -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Expression" NAME="EXP_BUDGET_CALC" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO"
                    DESCRIPTION="Calcul date mois depuis GCID, ecart budget/realise, taux execution">
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="BUDGET_ID"        PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="DEPT_CODE"        PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CATEGORIE"        PRECISION="30" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="ANNEE"            PRECISION="4"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="STATUT_BUDGET"    PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="BUDGET_MENSUEL"   PRECISION="14" SCALE="2" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="REALISE_MENSUEL"  PRECISION="14" SCALE="2" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="GCID_MOIS"        PRECISION="2"  SCALE="0" PORTTYPE="INPUT"/>
      <!-- Outputs -->
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="MOIS_NUM"         PRECISION="2"  SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="GCID_MOIS"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="MOIS_LABEL"       PRECISION="15" SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="DECODE(GCID_MOIS, 1, 'Janvier', 2, 'Fevrier', 3, 'Mars', 4, 'Avril', 5, 'Mai', 6, 'Juin', 7, 'Juillet', 8, 'Aout', 9, 'Septembre', 10, 'Octobre', 11, 'Novembre', 12, 'Decembre', 'Inconnu')"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="PERIODE_KEY"      PRECISION="7"  SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="TO_CHAR(ANNEE) || '-' || LPAD(TO_CHAR(GCID_MOIS), 2, '0')"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="ECART_ABSOLU"     PRECISION="14" SCALE="2" PORTTYPE="OUTPUT"
                      EXPRESSION="REALISE_MENSUEL - BUDGET_MENSUEL"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="TAUX_EXECUTION_PCT" PRECISION="8" SCALE="4" PORTTYPE="OUTPUT"
                      EXPRESSION="IIF(BUDGET_MENSUEL &gt; 0, REALISE_MENSUEL / BUDGET_MENSUEL * 100, 0)"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="STATUT_EXECUTION" PRECISION="15" SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="IIF(BUDGET_MENSUEL = 0, 'SANS_BUDGET', IIF(TAUX_EXECUTION_PCT &gt;= 100, 'DEPASSE', IIF(TAUX_EXECUTION_PCT &gt;= 90, 'ATTEINT', IIF(TAUX_EXECUTION_PCT &gt;= 50, 'EN_COURS', 'FAIBLE'))))"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CATEGORIE_CLEAN"  PRECISION="30" SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="LTRIM(RTRIM(UPPER(CATEGORIE)))"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="DW_LOAD_DATE"     PRECISION="29" SCALE="9" PORTTYPE="OUTPUT"
                      EXPRESSION="SYSDATE"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="BATCH_DATE_OUT"   PRECISION="29" SCALE="9" PORTTYPE="OUTPUT"
                      EXPRESSION="TO_DATE($$BATCH_DATE, 'YYYY-MM-DD')"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- FILTER : MOIS AVEC BUDGET OU REALISE NON NUL                  -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Filter" NAME="FIL_MOIS_ACTIF" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO"
                    DESCRIPTION="Garde uniquement les mois avec activite budgetaire">
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="BUDGET_MENSUEL"  PRECISION="14" SCALE="2" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="REALISE_MENSUEL" PRECISION="14" SCALE="2" PORTTYPE="INPUT"/>
      <TABLEATTRIBUTE NAME="Filter Condition" VALUE="NOT (BUDGET_MENSUEL = 0 AND (ISNULL(REALISE_MENSUEL) OR REALISE_MENSUEL = 0))"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- TARGET : FACT_BUDGET_MENSUEL                                   -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Target Definition" NAME="TGT_FACT_BUDGET_MENSUEL" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO">
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="BUDGET_ID"           PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="DEPT_CODE"           PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CATEGORIE_CLEAN"     PRECISION="30" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="ANNEE"               PRECISION="4"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="MOIS_NUM"            PRECISION="2"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="MOIS_LABEL"          PRECISION="15" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="PERIODE_KEY"         PRECISION="7"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="BUDGET_MENSUEL"      PRECISION="14" SCALE="2" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="REALISE_MENSUEL"     PRECISION="14" SCALE="2" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="ECART_ABSOLU"        PRECISION="14" SCALE="2" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="TAUX_EXECUTION_PCT"  PRECISION="8"  SCALE="4" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="STATUT_EXECUTION"    PRECISION="15" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="STATUT_BUDGET"       PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="BATCH_DATE"          PRECISION="29" SCALE="9" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="DW_LOAD_DATE"        PRECISION="29" SCALE="9" PORTTYPE="INPUT"/>
    </TRANSFORMATION>

    <!-- CONNECTORS SQ → NRM -->
    <CONNECTOR FROMTRANSFORMATION="SQ_BUDGET_ANNUEL" FROMFIELD="BUDGET_ID"      TOTRANSFORMATION="NRM_BUDGET_MENSUEL" TOFIELD="BUDGET_ID"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_BUDGET_ANNUEL" FROMFIELD="DEPT_CODE"      TOTRANSFORMATION="NRM_BUDGET_MENSUEL" TOFIELD="DEPT_CODE"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_BUDGET_ANNUEL" FROMFIELD="CATEGORIE"      TOTRANSFORMATION="NRM_BUDGET_MENSUEL" TOFIELD="CATEGORIE"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_BUDGET_ANNUEL" FROMFIELD="ANNEE"          TOTRANSFORMATION="NRM_BUDGET_MENSUEL" TOFIELD="ANNEE"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_BUDGET_ANNUEL" FROMFIELD="STATUT_BUDGET"  TOTRANSFORMATION="NRM_BUDGET_MENSUEL" TOFIELD="STATUT_BUDGET"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_BUDGET_ANNUEL" FROMFIELD="BUDGET_M01"     TOTRANSFORMATION="NRM_BUDGET_MENSUEL" TOFIELD="BUDGET_M[1]"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_BUDGET_ANNUEL" FROMFIELD="BUDGET_M02"     TOTRANSFORMATION="NRM_BUDGET_MENSUEL" TOFIELD="BUDGET_M[2]"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_BUDGET_ANNUEL" FROMFIELD="BUDGET_M03"     TOTRANSFORMATION="NRM_BUDGET_MENSUEL" TOFIELD="BUDGET_M[3]"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_BUDGET_ANNUEL" FROMFIELD="BUDGET_M04"     TOTRANSFORMATION="NRM_BUDGET_MENSUEL" TOFIELD="BUDGET_M[4]"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_BUDGET_ANNUEL" FROMFIELD="BUDGET_M05"     TOTRANSFORMATION="NRM_BUDGET_MENSUEL" TOFIELD="BUDGET_M[5]"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_BUDGET_ANNUEL" FROMFIELD="BUDGET_M06"     TOTRANSFORMATION="NRM_BUDGET_MENSUEL" TOFIELD="BUDGET_M[6]"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_BUDGET_ANNUEL" FROMFIELD="BUDGET_M07"     TOTRANSFORMATION="NRM_BUDGET_MENSUEL" TOFIELD="BUDGET_M[7]"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_BUDGET_ANNUEL" FROMFIELD="BUDGET_M08"     TOTRANSFORMATION="NRM_BUDGET_MENSUEL" TOFIELD="BUDGET_M[8]"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_BUDGET_ANNUEL" FROMFIELD="BUDGET_M09"     TOTRANSFORMATION="NRM_BUDGET_MENSUEL" TOFIELD="BUDGET_M[9]"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_BUDGET_ANNUEL" FROMFIELD="BUDGET_M10"     TOTRANSFORMATION="NRM_BUDGET_MENSUEL" TOFIELD="BUDGET_M[10]"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_BUDGET_ANNUEL" FROMFIELD="BUDGET_M11"     TOTRANSFORMATION="NRM_BUDGET_MENSUEL" TOFIELD="BUDGET_M[11]"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_BUDGET_ANNUEL" FROMFIELD="BUDGET_M12"     TOTRANSFORMATION="NRM_BUDGET_MENSUEL" TOFIELD="BUDGET_M[12]"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_BUDGET_ANNUEL" FROMFIELD="REALISE_M01"    TOTRANSFORMATION="NRM_BUDGET_MENSUEL" TOFIELD="REALISE_M[1]"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_BUDGET_ANNUEL" FROMFIELD="REALISE_M02"    TOTRANSFORMATION="NRM_BUDGET_MENSUEL" TOFIELD="REALISE_M[2]"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_BUDGET_ANNUEL" FROMFIELD="REALISE_M03"    TOTRANSFORMATION="NRM_BUDGET_MENSUEL" TOFIELD="REALISE_M[3]"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_BUDGET_ANNUEL" FROMFIELD="REALISE_M04"    TOTRANSFORMATION="NRM_BUDGET_MENSUEL" TOFIELD="REALISE_M[4]"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_BUDGET_ANNUEL" FROMFIELD="REALISE_M05"    TOTRANSFORMATION="NRM_BUDGET_MENSUEL" TOFIELD="REALISE_M[5]"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_BUDGET_ANNUEL" FROMFIELD="REALISE_M06"    TOTRANSFORMATION="NRM_BUDGET_MENSUEL" TOFIELD="REALISE_M[6]"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_BUDGET_ANNUEL" FROMFIELD="REALISE_M07"    TOTRANSFORMATION="NRM_BUDGET_MENSUEL" TOFIELD="REALISE_M[7]"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_BUDGET_ANNUEL" FROMFIELD="REALISE_M08"    TOTRANSFORMATION="NRM_BUDGET_MENSUEL" TOFIELD="REALISE_M[8]"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_BUDGET_ANNUEL" FROMFIELD="REALISE_M09"    TOTRANSFORMATION="NRM_BUDGET_MENSUEL" TOFIELD="REALISE_M[9]"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_BUDGET_ANNUEL" FROMFIELD="REALISE_M10"    TOTRANSFORMATION="NRM_BUDGET_MENSUEL" TOFIELD="REALISE_M[10]"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_BUDGET_ANNUEL" FROMFIELD="REALISE_M11"    TOTRANSFORMATION="NRM_BUDGET_MENSUEL" TOFIELD="REALISE_M[11]"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_BUDGET_ANNUEL" FROMFIELD="REALISE_M12"    TOTRANSFORMATION="NRM_BUDGET_MENSUEL" TOFIELD="REALISE_M[12]"/>
    <!-- NRM → EXP -->
    <CONNECTOR FROMTRANSFORMATION="NRM_BUDGET_MENSUEL" FROMFIELD="BUDGET_ID_OUT"    TOTRANSFORMATION="EXP_BUDGET_CALC" TOFIELD="BUDGET_ID"/>
