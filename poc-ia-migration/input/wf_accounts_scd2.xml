    <CONNECTOR FROMTRANSFORMATION="RTR_SCD2_ACTION" FROMFIELD="CREDIT_LIMIT"      FROMGROUP="GRP_INSERT" TOTRANSFORMATION="TGT_DIM_ACCOUNTS_INSERT" TOFIELD="CREDIT_LIMIT"/>
    <CONNECTOR FROMTRANSFORMATION="RTR_SCD2_ACTION" FROMFIELD="MANAGER_CODE"      FROMGROUP="GRP_INSERT" TOTRANSFORMATION="TGT_DIM_ACCOUNTS_INSERT" TOFIELD="MANAGER_CODE"/>
    <CONNECTOR FROMTRANSFORMATION="RTR_SCD2_ACTION" FROMFIELD="STATUS"            FROMGROUP="GRP_INSERT" TOTRANSFORMATION="TGT_DIM_ACCOUNTS_INSERT" TOFIELD="STATUS"/>
