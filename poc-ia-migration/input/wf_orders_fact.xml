      <TRANSFORMFIELD DATATYPE="string"    NAME="CHANNEL_CLEAN"  PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="COUNTRY_CODE"   PRECISION="3"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="ORDER_YEAR"     PRECISION="4"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="ORDER_MONTH"    PRECISION="2"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="ORDER_COUNT"    PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="TOTAL_GROSS"    PRECISION="16" SCALE="2" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="TOTAL_DISCOUNT" PRECISION="16" SCALE="2" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="TOTAL_NET"      PRECISION="16" SCALE="2" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="TOTAL_QTY"      PRECISION="12" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="integer"   NAME="PROMO_ORDERS"   PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="BATCH_DATE"     PRECISION="29" SCALE="9" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="DW_LOAD_DATE"   PRECISION="29" SCALE="9" PORTTYPE="INPUT"/>
    </TRANSFORMATION>

