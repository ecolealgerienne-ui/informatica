    <CONNECTOR FROMTRANSFORMATION="EXP_BUDGET_CALC"    FROMFIELD="BUDGET_ID"        TOTRANSFORMATION="TGT_FACT_BUDGET_MENSUEL" TOFIELD="BUDGET_ID"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_BUDGET_CALC"    FROMFIELD="DEPT_CODE"        TOTRANSFORMATION="TGT_FACT_BUDGET_MENSUEL" TOFIELD="DEPT_CODE"/>
