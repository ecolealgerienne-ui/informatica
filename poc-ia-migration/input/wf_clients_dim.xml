      <TRANSFORMFIELD DATATYPE="nstring" NAME="PRENOM_CLEAN" PORTTYPE="OUTPUT"
                      PRECISION="100" SCALE="0"
                      EXPRESSION="LTRIM(RTRIM(UPPER(PRENOM)))"/>
      <TRANSFORMFIELD DATATYPE="number" NAME="AGE" PORTTYPE="OUTPUT"
                      PRECISION="3" SCALE="0"
                      EXPRESSION="DATEDIFF(SYSDATE,DATE_NAISSANCE,&apos;YY&apos;)"/>
      <TRANSFORMFIELD DATATYPE="nstring" NAME="EMAIL_LOWER" PORTTYPE="OUTPUT"
                      PRECISION="200" SCALE="0"
                      EXPRESSION="LOWER(LTRIM(RTRIM(EMAIL)))"/>
