<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE POWERMART SYSTEM "powrmart.dtd">
<POWERMART CREATION_DATE="06/24/2026 08:00:00" REPOSITORY_VERSION="184.94">
<REPOSITORY NAME="REP_PROD" VERSION="184" CODEPAGE="UTF-8" DATABASETYPE="Oracle">
<FOLDER NAME="MIGRATION_POC" GROUP="" OWNER="etl_dev" SHARED="NOTSHARED" DESCRIPTION="POC Migration" PERMISSIONS="rwx---r--">

  <MAPPING NAME="m_accounts_scd2" ISVALID="YES" OBJECTVERSION="1" VERSIONNUMBER="1"
           DESCRIPTION="Dimension comptes avec SCD Type 2 - historisation des changements - HIGH complexity">

    <!-- ============================================================ -->
    <!-- SOURCE : TABLE ACCOUNTS (source systeme CRM)                  -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Source Qualifier" NAME="SQ_ACCOUNTS" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO" DESCRIPTION="Extraction comptes modifies">
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="ACCOUNT_ID"     PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="ACCOUNT_CODE"   PRECISION="20" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="ACCOUNT_NAME"   PRECISION="100" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="ACCOUNT_TYPE"   PRECISION="20" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="LEGAL_FORM"     PRECISION="30" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="COUNTRY_CODE"   PRECISION="3"  SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CITY"           PRECISION="50" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="RISK_CLASS"     PRECISION="5"  SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="CREDIT_LIMIT"   PRECISION="14" SCALE="2" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="MANAGER_CODE"   PRECISION="20" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="STATUS"         PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="DATE_MODIFIED"  PRECISION="29" SCALE="9" PORTTYPE="OUTPUT"/>
      <TABLEATTRIBUTE NAME="Sql Query" VALUE="SELECT ACCOUNT_ID, ACCOUNT_CODE, ACCOUNT_NAME, ACCOUNT_TYPE, LEGAL_FORM, COUNTRY_CODE, CITY, RISK_CLASS, CREDIT_LIMIT, MANAGER_CODE, STATUS, DATE_MODIFIED FROM ACCOUNTS WHERE DATE_MODIFIED &gt;= TO_DATE('$$BATCH_DATE', 'YYYY-MM-DD')"/>
      <TABLEATTRIBUTE NAME="Source Table" VALUE="ACCOUNTS"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- LOOKUP : DIMENSION EXISTANTE (pour comparer version courante)  -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Lookup Procedure" NAME="LKP_DIM_ACCOUNTS_CURR" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO" DESCRIPTION="Recupere la version courante de la dimension">
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="IN_ACCOUNT_ID"    PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="ACCOUNT_SK"       PRECISION="15" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CURR_ACCOUNT_NAME" PRECISION="100" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CURR_RISK_CLASS"  PRECISION="5"  SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="CURR_CREDIT_LIMIT" PRECISION="14" SCALE="2" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CURR_COUNTRY_CODE" PRECISION="3"  SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CURR_MANAGER_CODE" PRECISION="20" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="EFF_START_DATE"   PRECISION="29" SCALE="9" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="IS_CURRENT"       PRECISION="1"  SCALE="0" PORTTYPE="OUTPUT"/>
      <TABLEATTRIBUTE NAME="Lookup table name" VALUE="DIM_ACCOUNTS"/>
      <TABLEATTRIBUTE NAME="Lookup Condition" VALUE="IN_ACCOUNT_ID = ACCOUNT_ID AND IS_CURRENT = 'Y'"/>
      <TABLEATTRIBUTE NAME="Lookup Policy On Multiple Match" VALUE="Return First Row"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- SEQUENCE GENERATOR : CLE SURROGATE                            -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Sequence Generator" NAME="SEQ_ACCOUNT_SK" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="YES" DESCRIPTION="Generateur de cle surrogate pour SCD2">
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="NEXTVAL"        PRECISION="15" SCALE="0" PORTTYPE="OUTPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="CURRVAL"        PRECISION="15" SCALE="0" PORTTYPE="OUTPUT"/>
      <TABLEATTRIBUTE NAME="Start Value"   VALUE="1"/>
      <TABLEATTRIBUTE NAME="Increment By"  VALUE="1"/>
      <TABLEATTRIBUTE NAME="End Value"     VALUE="9999999999999"/>
      <TABLEATTRIBUTE NAME="Current Value" VALUE="50000"/>
      <TABLEATTRIBUTE NAME="Cycle"         VALUE="NO"/>
      <TABLEATTRIBUTE NAME="Reset"         VALUE="NO"/>
      <TABLEATTRIBUTE NAME="Number of Cached Values" VALUE="100"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- EXPRESSION : DETECTION CHANGEMENT + STRATEGIE SCD2            -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Expression" NAME="EXP_SCD2_DETECT" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO"
                    DESCRIPTION="Detection des changements pour SCD2 : INSERT ou UPDATE/CLOSE+INSERT">
      <!-- Inputs depuis SQ -->
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="ACCOUNT_ID"      PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="ACCOUNT_CODE"    PRECISION="20" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="ACCOUNT_NAME"    PRECISION="100" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="ACCOUNT_TYPE"    PRECISION="20" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="LEGAL_FORM"      PRECISION="30" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="COUNTRY_CODE"    PRECISION="3"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CITY"            PRECISION="50" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="RISK_CLASS"      PRECISION="5"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="CREDIT_LIMIT"    PRECISION="14" SCALE="2" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="MANAGER_CODE"    PRECISION="20" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="STATUS"          PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="DATE_MODIFIED"   PRECISION="29" SCALE="9" PORTTYPE="INPUT"/>
      <!-- Inputs depuis LKP -->
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="ACCOUNT_SK"      PRECISION="15" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CURR_ACCOUNT_NAME" PRECISION="100" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CURR_RISK_CLASS"  PRECISION="5"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="CURR_CREDIT_LIMIT" PRECISION="14" SCALE="2" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CURR_COUNTRY_CODE" PRECISION="3"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CURR_MANAGER_CODE" PRECISION="20" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="EFF_START_DATE"   PRECISION="29" SCALE="9" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="IS_CURRENT_IN"    PRECISION="1"  SCALE="0" PORTTYPE="INPUT"/>
      <!-- Inputs depuis SEQ -->
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="NEW_SK"           PRECISION="15" SCALE="0" PORTTYPE="INPUT"/>
      <!-- Outputs : decision SCD2 -->
      <TRANSFORMFIELD DATATYPE="string"    NAME="SCD_ACTION"       PRECISION="10" SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="IIF(ISNULL(ACCOUNT_SK), 'INSERT', IIF(ACCOUNT_NAME != CURR_ACCOUNT_NAME OR RISK_CLASS != CURR_RISK_CLASS OR CREDIT_LIMIT != CURR_CREDIT_LIMIT OR COUNTRY_CODE != CURR_COUNTRY_CODE OR MANAGER_CODE != CURR_MANAGER_CODE, 'SCD2', 'NOCHANGE'))"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="FINAL_SK"         PRECISION="15" SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="IIF(ISNULL(ACCOUNT_SK), NEW_SK, IIF(SCD_ACTION = 'SCD2', NEW_SK, ACCOUNT_SK))"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="ACCOUNT_NAME_CLEAN" PRECISION="100" SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="LTRIM(RTRIM(UPPER(ACCOUNT_NAME)))"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CITY_CLEAN"        PRECISION="50" SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="LTRIM(RTRIM(INITCAP(CITY)))"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="RISK_LABEL"        PRECISION="20" SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="DECODE(RISK_CLASS, 'A', 'Risque Faible', 'B', 'Risque Moyen', 'C', 'Risque Eleve', 'D', 'Risque Critique', 'Non Classe')"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="NEW_EFF_START"     PRECISION="29" SCALE="9" PORTTYPE="OUTPUT"
                      EXPRESSION="TO_DATE($$BATCH_DATE, 'YYYY-MM-DD')"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="NEW_EFF_END"       PRECISION="29" SCALE="9" PORTTYPE="OUTPUT"
                      EXPRESSION="TO_DATE('9999-12-31', 'YYYY-MM-DD')"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="CLOSE_EFF_END"     PRECISION="29" SCALE="9" PORTTYPE="OUTPUT"
                      EXPRESSION="DATEADD(DAY, -1, TO_DATE($$BATCH_DATE, 'YYYY-MM-DD'))"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="IS_CURRENT_OUT"    PRECISION="1"  SCALE="0" PORTTYPE="OUTPUT"
                      EXPRESSION="'Y'"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="DW_LOAD_DATE"      PRECISION="29" SCALE="9" PORTTYPE="OUTPUT"
                      EXPRESSION="SYSDATE"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- ROUTER : AIGUILLE VERS INSERT / UPDATE / IGNORE               -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Router" NAME="RTR_SCD2_ACTION" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO" DESCRIPTION="Route selon action SCD2 detectee">
      <TRANSFORMFIELD DATATYPE="string"    NAME="SCD_ACTION"        PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="ACCOUNT_ID"        PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="ACCOUNT_SK"        PRECISION="15" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="FINAL_SK"          PRECISION="15" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="ACCOUNT_CODE"      PRECISION="20" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="ACCOUNT_NAME_CLEAN" PRECISION="100" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="ACCOUNT_TYPE"      PRECISION="20" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="LEGAL_FORM"        PRECISION="30" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="COUNTRY_CODE"      PRECISION="3"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CITY_CLEAN"        PRECISION="50" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="RISK_CLASS"        PRECISION="5"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="RISK_LABEL"        PRECISION="20" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="CREDIT_LIMIT"      PRECISION="14" SCALE="2" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="MANAGER_CODE"      PRECISION="20" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="STATUS"            PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="NEW_EFF_START"     PRECISION="29" SCALE="9" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="NEW_EFF_END"       PRECISION="29" SCALE="9" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="CLOSE_EFF_END"     PRECISION="29" SCALE="9" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="IS_CURRENT_OUT"    PRECISION="1"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="DW_LOAD_DATE"      PRECISION="29" SCALE="9" PORTTYPE="INPUT"/>
      <TABLEATTRIBUTE NAME="Output1.Group Name"      VALUE="GRP_INSERT"/>
      <TABLEATTRIBUTE NAME="Output1.Group Condition" VALUE="SCD_ACTION = 'INSERT'"/>
      <TABLEATTRIBUTE NAME="Output2.Group Name"      VALUE="GRP_SCD2"/>
      <TABLEATTRIBUTE NAME="Output2.Group Condition" VALUE="SCD_ACTION = 'SCD2'"/>
      <TABLEATTRIBUTE NAME="Output3.Group Name"      VALUE="GRP_DEFAULT"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- UPDATE STRATEGY : CLORE L'ANCIENNE VERSION (SCD2)             -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Update Strategy" NAME="UPD_CLOSE_OLD_VERSION" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO" DESCRIPTION="Met a jour EFF_END_DATE de l'ancienne version">
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="ACCOUNT_SK"      PRECISION="15" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="CLOSE_EFF_END"   PRECISION="29" SCALE="9" PORTTYPE="INPUT"/>
      <TABLEATTRIBUTE NAME="Update Strategy Expression" VALUE="DD_UPDATE"/>
      <TABLEATTRIBUTE NAME="Forward Rejected Rows"      VALUE="NO"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- TARGET 1 : INSERT NOUVELLE VERSION                            -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Target Definition" NAME="TGT_DIM_ACCOUNTS_INSERT" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO" DESCRIPTION="Insert nouvelle version SCD2">
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="ACCOUNT_SK"       PRECISION="15" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="ACCOUNT_ID"       PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="ACCOUNT_CODE"     PRECISION="20" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="ACCOUNT_NAME_CLEAN" PRECISION="100" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="ACCOUNT_TYPE"     PRECISION="20" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="LEGAL_FORM"       PRECISION="30" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="COUNTRY_CODE"     PRECISION="3"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="CITY_CLEAN"       PRECISION="50" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="RISK_CLASS"       PRECISION="5"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="RISK_LABEL"       PRECISION="20" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="CREDIT_LIMIT"     PRECISION="14" SCALE="2" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="MANAGER_CODE"     PRECISION="20" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="STATUS"           PRECISION="10" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="EFF_START_DATE"   PRECISION="29" SCALE="9" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="EFF_END_DATE"     PRECISION="29" SCALE="9" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="string"    NAME="IS_CURRENT"       PRECISION="1"  SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="DW_LOAD_DATE"     PRECISION="29" SCALE="9" PORTTYPE="INPUT"/>
    </TRANSFORMATION>

    <!-- ============================================================ -->
    <!-- TARGET 2 : UPDATE ANCIENNE VERSION (CLOSE)                    -->
    <!-- ============================================================ -->
    <TRANSFORMATION TYPE="Target Definition" NAME="TGT_DIM_ACCOUNTS_UPDATE" ISVALID="YES"
                    OBJECTVERSION="1" REUSABLE="NO" DESCRIPTION="Update EFF_END_DATE ancienne version">
      <TRANSFORMFIELD DATATYPE="decimal"   NAME="ACCOUNT_SK"      PRECISION="15" SCALE="0" PORTTYPE="INPUT"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="EFF_END_DATE"    PRECISION="29" SCALE="9" PORTTYPE="INPUT"/>
    </TRANSFORMATION>

    <!-- CONNECTORS SQ → LKP + EXP -->
    <CONNECTOR FROMTRANSFORMATION="SQ_ACCOUNTS" FROMFIELD="ACCOUNT_ID"    TOTRANSFORMATION="LKP_DIM_ACCOUNTS_CURR" TOFIELD="IN_ACCOUNT_ID"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_ACCOUNTS" FROMFIELD="ACCOUNT_ID"    TOTRANSFORMATION="EXP_SCD2_DETECT"       TOFIELD="ACCOUNT_ID"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_ACCOUNTS" FROMFIELD="ACCOUNT_CODE"  TOTRANSFORMATION="EXP_SCD2_DETECT"       TOFIELD="ACCOUNT_CODE"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_ACCOUNTS" FROMFIELD="ACCOUNT_NAME"  TOTRANSFORMATION="EXP_SCD2_DETECT"       TOFIELD="ACCOUNT_NAME"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_ACCOUNTS" FROMFIELD="ACCOUNT_TYPE"  TOTRANSFORMATION="EXP_SCD2_DETECT"       TOFIELD="ACCOUNT_TYPE"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_ACCOUNTS" FROMFIELD="LEGAL_FORM"    TOTRANSFORMATION="EXP_SCD2_DETECT"       TOFIELD="LEGAL_FORM"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_ACCOUNTS" FROMFIELD="COUNTRY_CODE"  TOTRANSFORMATION="EXP_SCD2_DETECT"       TOFIELD="COUNTRY_CODE"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_ACCOUNTS" FROMFIELD="CITY"          TOTRANSFORMATION="EXP_SCD2_DETECT"       TOFIELD="CITY"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_ACCOUNTS" FROMFIELD="RISK_CLASS"    TOTRANSFORMATION="EXP_SCD2_DETECT"       TOFIELD="RISK_CLASS"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_ACCOUNTS" FROMFIELD="CREDIT_LIMIT"  TOTRANSFORMATION="EXP_SCD2_DETECT"       TOFIELD="CREDIT_LIMIT"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_ACCOUNTS" FROMFIELD="MANAGER_CODE"  TOTRANSFORMATION="EXP_SCD2_DETECT"       TOFIELD="MANAGER_CODE"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_ACCOUNTS" FROMFIELD="STATUS"        TOTRANSFORMATION="EXP_SCD2_DETECT"       TOFIELD="STATUS"/>
    <CONNECTOR FROMTRANSFORMATION="SQ_ACCOUNTS" FROMFIELD="DATE_MODIFIED" TOTRANSFORMATION="EXP_SCD2_DETECT"       TOFIELD="DATE_MODIFIED"/>
    <CONNECTOR FROMTRANSFORMATION="LKP_DIM_ACCOUNTS_CURR" FROMFIELD="ACCOUNT_SK"       TOTRANSFORMATION="EXP_SCD2_DETECT" TOFIELD="ACCOUNT_SK"/>
    <CONNECTOR FROMTRANSFORMATION="LKP_DIM_ACCOUNTS_CURR" FROMFIELD="CURR_ACCOUNT_NAME" TOTRANSFORMATION="EXP_SCD2_DETECT" TOFIELD="CURR_ACCOUNT_NAME"/>
    <CONNECTOR FROMTRANSFORMATION="LKP_DIM_ACCOUNTS_CURR" FROMFIELD="CURR_RISK_CLASS"  TOTRANSFORMATION="EXP_SCD2_DETECT" TOFIELD="CURR_RISK_CLASS"/>
    <CONNECTOR FROMTRANSFORMATION="LKP_DIM_ACCOUNTS_CURR" FROMFIELD="CURR_CREDIT_LIMIT" TOTRANSFORMATION="EXP_SCD2_DETECT" TOFIELD="CURR_CREDIT_LIMIT"/>
    <CONNECTOR FROMTRANSFORMATION="LKP_DIM_ACCOUNTS_CURR" FROMFIELD="CURR_COUNTRY_CODE" TOTRANSFORMATION="EXP_SCD2_DETECT" TOFIELD="CURR_COUNTRY_CODE"/>
    <CONNECTOR FROMTRANSFORMATION="LKP_DIM_ACCOUNTS_CURR" FROMFIELD="CURR_MANAGER_CODE" TOTRANSFORMATION="EXP_SCD2_DETECT" TOFIELD="CURR_MANAGER_CODE"/>
    <CONNECTOR FROMTRANSFORMATION="LKP_DIM_ACCOUNTS_CURR" FROMFIELD="EFF_START_DATE"   TOTRANSFORMATION="EXP_SCD2_DETECT" TOFIELD="EFF_START_DATE"/>
    <CONNECTOR FROMTRANSFORMATION="LKP_DIM_ACCOUNTS_CURR" FROMFIELD="IS_CURRENT"       TOTRANSFORMATION="EXP_SCD2_DETECT" TOFIELD="IS_CURRENT_IN"/>
    <CONNECTOR FROMTRANSFORMATION="SEQ_ACCOUNT_SK" FROMFIELD="NEXTVAL" TOTRANSFORMATION="EXP_SCD2_DETECT" TOFIELD="NEW_SK"/>
    <!-- EXP → RTR -->
    <CONNECTOR FROMTRANSFORMATION="EXP_SCD2_DETECT" FROMFIELD="SCD_ACTION"        TOTRANSFORMATION="RTR_SCD2_ACTION" TOFIELD="SCD_ACTION"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_SCD2_DETECT" FROMFIELD="ACCOUNT_ID"        TOTRANSFORMATION="RTR_SCD2_ACTION" TOFIELD="ACCOUNT_ID"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_SCD2_DETECT" FROMFIELD="ACCOUNT_SK"        TOTRANSFORMATION="RTR_SCD2_ACTION" TOFIELD="ACCOUNT_SK"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_SCD2_DETECT" FROMFIELD="FINAL_SK"          TOTRANSFORMATION="RTR_SCD2_ACTION" TOFIELD="FINAL_SK"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_SCD2_DETECT" FROMFIELD="ACCOUNT_CODE"      TOTRANSFORMATION="RTR_SCD2_ACTION" TOFIELD="ACCOUNT_CODE"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_SCD2_DETECT" FROMFIELD="ACCOUNT_NAME_CLEAN" TOTRANSFORMATION="RTR_SCD2_ACTION" TOFIELD="ACCOUNT_NAME_CLEAN"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_SCD2_DETECT" FROMFIELD="ACCOUNT_TYPE"      TOTRANSFORMATION="RTR_SCD2_ACTION" TOFIELD="ACCOUNT_TYPE"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_SCD2_DETECT" FROMFIELD="LEGAL_FORM"        TOTRANSFORMATION="RTR_SCD2_ACTION" TOFIELD="LEGAL_FORM"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_SCD2_DETECT" FROMFIELD="COUNTRY_CODE"      TOTRANSFORMATION="RTR_SCD2_ACTION" TOFIELD="COUNTRY_CODE"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_SCD2_DETECT" FROMFIELD="CITY_CLEAN"        TOTRANSFORMATION="RTR_SCD2_ACTION" TOFIELD="CITY_CLEAN"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_SCD2_DETECT" FROMFIELD="RISK_CLASS"        TOTRANSFORMATION="RTR_SCD2_ACTION" TOFIELD="RISK_CLASS"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_SCD2_DETECT" FROMFIELD="RISK_LABEL"        TOTRANSFORMATION="RTR_SCD2_ACTION" TOFIELD="RISK_LABEL"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_SCD2_DETECT" FROMFIELD="CREDIT_LIMIT"      TOTRANSFORMATION="RTR_SCD2_ACTION" TOFIELD="CREDIT_LIMIT"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_SCD2_DETECT" FROMFIELD="MANAGER_CODE"      TOTRANSFORMATION="RTR_SCD2_ACTION" TOFIELD="MANAGER_CODE"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_SCD2_DETECT" FROMFIELD="STATUS"            TOTRANSFORMATION="RTR_SCD2_ACTION" TOFIELD="STATUS"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_SCD2_DETECT" FROMFIELD="NEW_EFF_START"     TOTRANSFORMATION="RTR_SCD2_ACTION" TOFIELD="NEW_EFF_START"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_SCD2_DETECT" FROMFIELD="NEW_EFF_END"       TOTRANSFORMATION="RTR_SCD2_ACTION" TOFIELD="NEW_EFF_END"/>
    <CONNECTOR FROMTRANSFORMATION="EXP_SCD2_DETECT" FROMFIELD="CLOSE_EFF_END"     TOTRANSFORMATION="RTR_SCD2_ACTION" TOFIELD="CLOSE_EFF_END"/>
