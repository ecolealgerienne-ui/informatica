    <CONNECTOR FROMTRANSFORMATION="RTR_SCD2_ACTION" FROMFIELD="ACCOUNT_SK"        FROMGROUP="GRP_SCD2" TOTRANSFORMATION="UPD_CLOSE_OLD_VERSION" TOFIELD="ACCOUNT_SK"/>
